<Window x:Class="Clinic.Presentation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Clinic.Presentation.ViewModels"
        xmlns:views="clr-namespace:Clinic.Presentation.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="陈医生诊所处方管理系统"
        Height="700" Width="1100"
        MinHeight="650" MinWidth="1000"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:NullToCollapsedConverter x:Key="NullToCollapsed"
                                        xmlns:conv="clr-namespace:Clinic.Presentation.Converters"/>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PatientManagementViewModel}">
            <views:PatientManagementView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PrescriptionViewModel}">
            <views:PrescriptionView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BillingViewModel}">
            <views:BillingView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:InventoryViewModel}">
            <views:InventoryView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PrescriptionHistoryViewModel}">
            <views:PrescriptionHistoryView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MedicalRecordManagementViewModel}">
            <views:MedicalRecordManagementView/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ======== 侧边导航栏 ======== -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}"
                BorderBrush="{StaticResource SidebarBorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="0,0">

                <!-- Logo + 系统标题 -->
                <StackPanel DockPanel.Dock="Top" Margin="20,20,20,16">
                    <DockPanel Margin="0,0,0,12">
                        <Border Width="36" Height="36" CornerRadius="8"
                                Background="{StaticResource PrimaryBrush}"
                                DockPanel.Dock="Left" Margin="0,0,10,0">
                            <Path Data="{StaticResource IconMedicalCross}"
                                  Width="20" Height="20" Stretch="Uniform"
                                  Stroke="White" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="陈医生诊所处方管理系统" FontSize="{StaticResource FontSizeCaption}" FontWeight="Bold"
                                       Foreground="{StaticResource Gray800Brush}"/>
                            <TextBlock Text="Dr. Chen's Clinic" FontSize="9"
                                       Foreground="{StaticResource Gray400Brush}"/>
                        </StackPanel>
                    </DockPanel>
                </StackPanel>

                <!-- 用户信息卡 -->
                <Border DockPanel.Dock="Top" Margin="12,0,12,12"
                        Background="White" CornerRadius="8"
                        BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1"
                        Padding="12,10">
                    <DockPanel>
                        <Border Width="32" Height="32" CornerRadius="16"
                                Background="{StaticResource PrimaryBgBrush}"
                                DockPanel.Dock="Left" Margin="0,0,10,0">
                            <Path Data="{StaticResource IconUserCircle}"
                                  Width="18" Height="18" Stretch="Uniform"
                                  Stroke="{StaticResource PrimaryBrush}" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Button DockPanel.Dock="Right"
                                Style="{StaticResource BtnOutlineSm}"
                                Command="{Binding EditDoctorNameCommand}"
                                Padding="6,2" Margin="0,0,0,0"
                                ToolTip="修改医生姓名"
                                Visibility="{Binding CanPrescribe, Converter={StaticResource BoolToVis}}">
                            <Path Data="{StaticResource IconEdit}"
                                  Width="12" Height="12" Stretch="Uniform"
                                  Stroke="{StaticResource Gray600Brush}" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  VerticalAlignment="Center"/>
                        </Button>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentUserDisplayName}"
                                       FontSize="{StaticResource FontSizeSmall}" FontWeight="SemiBold"
                                       Foreground="{StaticResource Gray800Brush}"/>
                            <TextBlock Text="{Binding CurrentUserRoleText}"
                                       FontSize="{StaticResource FontSizeTiny}" Foreground="{StaticResource Gray500Brush}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- 退出登录按钮 -->
                <Button DockPanel.Dock="Bottom"
                        Style="{StaticResource BtnOutline}"
                        Margin="12,8" Padding="0,8"
                        Command="{Binding LogoutCommand}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Path Data="{StaticResource IconLogout}"
                              Width="16" Height="16" Stretch="Uniform"
                              Stroke="{StaticResource Gray600Brush}" StrokeThickness="2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="退出登录" FontSize="{StaticResource FontSizeSmall}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- 导航菜单 -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="8,4,8,0">
                    <StackPanel>

                        <!-- 工作台 Dashboard（首页） -->
                        <Button Style="{StaticResource BtnNav}"
                                Command="{Binding NavigateToDashboardCommand}"
                                Tag="Dashboard"
                                Margin="0,0,0,4">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconHome}"
                                      Width="18" Height="18" Stretch="Uniform"
                                      Stroke="{StaticResource Gray600Brush}" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="工作台" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 处方开具（核心业务，首选入口） -->
                        <Button Style="{StaticResource BtnNav}"
                                Command="{Binding NavigateToPrescriptionCommand}"
                                Tag="Prescription"
                                Visibility="{Binding CanPrescribe, Converter={StaticResource BoolToVis}}"
                                Margin="0,0,0,4">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconClipboardList}"
                                      Width="18" Height="18" Stretch="Uniform"
                                      Stroke="{StaticResource Gray600Brush}" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="处方开具" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 收费管理 -->
                        <Button Style="{StaticResource BtnNav}"
                                Command="{Binding NavigateToBillingCommand}"
                                Tag="Billing"
                                Margin="0,0,0,4">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconReceipt}"
                                      Width="18" Height="18" Stretch="Uniform"
                                      Stroke="{StaticResource Gray600Brush}" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="收费管理" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 库存管理 -->
                        <Button Style="{StaticResource BtnNav}"
                                Command="{Binding NavigateToInventoryCommand}"
                                Tag="Inventory"
                                Margin="0,0,0,4">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconPackage}"
                                      Width="18" Height="18" Stretch="Uniform"
                                      Stroke="{StaticResource Gray600Brush}" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="库存管理" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 处方查询 -->
                        <Button Style="{StaticResource BtnNav}"
                                Command="{Binding NavigateToPrescriptionHistoryCommand}"
                                Tag="PrescriptionHistory"
                                Margin="0,0,0,4">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconHistory}"
                                      Width="18" Height="18" Stretch="Uniform"
                                      Stroke="{StaticResource Gray600Brush}" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="处方查询" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 分隔线 -->
                        <Border Height="1" Background="{StaticResource BorderLightBrush}"
                                Margin="4,8,4,8"/>

                        <!-- 病历管理 -->
                        <Button Style="{StaticResource BtnNav}"
                                Command="{Binding NavigateToMedicalRecordCommand}"
                                Tag="MedicalRecord"
                                Margin="0,0,0,4">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconClipboardList}"
                                      Width="18" Height="18" Stretch="Uniform"
                                      Stroke="{StaticResource Gray600Brush}" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="病历管理" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 患者管理（低频功能，移至分隔线下方） -->
                        <Button Style="{StaticResource BtnNav}"
                                Command="{Binding NavigateToPatientCommand}"
                                Tag="Patient"
                                Margin="0,0,0,4">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconUsers}"
                                      Width="18" Height="18" Stretch="Uniform"
                                      Stroke="{StaticResource Gray600Brush}" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="患者管理" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 系统工具标题 -->
                        <TextBlock Text="系统工具" FontSize="{StaticResource FontSizeMicro}" FontWeight="SemiBold"
                                   Foreground="{StaticResource Gray400Brush}"
                                   Margin="12,0,0,4"/>

                        <!-- 数据备份 -->
                        <Button Style="{StaticResource BtnNav}"
                                Command="{Binding CreateBackupCommand}"
                                Margin="0,0,0,4">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconDatabase}"
                                      Width="18" Height="18" Stretch="Uniform"
                                      Stroke="{StaticResource Gray600Brush}" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="数据备份" VerticalAlignment="Center" FontSize="{StaticResource FontSizeSmall}"/>
                            </StackPanel>
                        </Button>

                        <!-- 数据恢复 -->
                        <Button Style="{StaticResource BtnNav}"
                                Command="{Binding RestoreBackupCommand}"
                                Margin="0,0,0,4">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconDatabaseImport}"
                                      Width="18" Height="18" Stretch="Uniform"
                                      Stroke="{StaticResource Gray600Brush}" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="数据恢复" VerticalAlignment="Center" FontSize="{StaticResource FontSizeSmall}"/>
                            </StackPanel>
                        </Button>

                        <!-- 审计验证 -->
                        <Button Style="{StaticResource BtnNav}"
                                Command="{Binding VerifyAuditChainCommand}"
                                Margin="0,0,0,4">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconShieldCheck}"
                                      Width="18" Height="18" Stretch="Uniform"
                                      Stroke="{StaticResource Gray600Brush}" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="审计验证" VerticalAlignment="Center" FontSize="{StaticResource FontSizeSmall}"/>
                            </StackPanel>
                        </Button>

                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ======== 内容区域 ======== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 顶部状态消息 + AI 状态栏（操作反馈，紧邻内容区） -->
            <StackPanel Grid.Row="0" Margin="12,8,12,0">
                <!-- AI 状态栏 -->
                <Border Background="#F0FDF4"
                        CornerRadius="6" Padding="10,6"
                        BorderBrush="#BBF7D0" BorderThickness="1"
                        Visibility="{Binding AiStatusVisible, Converter={StaticResource BoolToVis}}">
                    <DockPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8"
                                     Fill="{Binding AiStatusColor}"
                                     VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding AiStatusText}"
                                       FontSize="{StaticResource FontSizeTiny}" Foreground="#166534"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <Button Content="加载大模型"
                                    Style="{StaticResource BtnOutlineSm}"
                                    Padding="8,2" Margin="4,0"
                                    Command="{Binding LoadAiModelCommand}"
                                    Visibility="{Binding AiLoadButtonVisible, Converter={StaticResource BoolToVis}}"/>
                            <Button Content="卸载大模型"
                                    Style="{StaticResource BtnOutlineSm}"
                                    Padding="8,2" Margin="4,0"
                                    Command="{Binding UnloadAiModelCommand}"
                                    Visibility="{Binding AiUnloadButtonVisible, Converter={StaticResource BoolToVis}}"/>
                            <Button Content="{Binding AiHealthCheckButtonText}"
                                    Style="{StaticResource BtnOutlineSm}"
                                    Padding="8,2" Margin="4,0"
                                    Command="{Binding RunAiHealthCheckCommand}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- 成功消息 -->
                <Border Background="{StaticResource SuccessBgBrush}"
                        CornerRadius="6" Padding="10,8" Margin="0,4,0,0"
                        Visibility="{Binding StatusMessage, Converter={StaticResource NullToCollapsed}}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconCircleCheck}"
                              Width="14" Height="14" Stretch="Uniform"
                              Stroke="{StaticResource SuccessBrush}" StrokeThickness="2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding StatusMessage}"
                                   Style="{StaticResource TextSuccess}" FontSize="{StaticResource FontSizeTiny}"/>
                    </StackPanel>
                </Border>
                <Border Background="{StaticResource ErrorBgBrush}"
                        CornerRadius="6" Padding="10,8" Margin="0,4,0,0"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource NullToCollapsed}}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconAlertTriangle}"
                              Width="14" Height="14" Stretch="Uniform"
                              Stroke="{StaticResource ErrorBrush}" StrokeThickness="2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Style="{StaticResource TextError}" FontSize="{StaticResource FontSizeTiny}"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 页面内容 -->
            <ContentControl Grid.Row="1"
                            Content="{Binding CurrentViewModel}"
                            Margin="0,4,0,0"/>
        </Grid>
    </Grid>
</Window>
