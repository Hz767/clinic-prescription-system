# ── .NET 构建产物 ──
**/bin/
**/obj/
**/Debug/
**/Release/

# ── 用户特定文件 ──
*.user
*.suo
*.userosscache
*.sln.docstates
*.vspscc
*.vssscc

# ── Visual Studio / Rider ──
.vs/
.idea/
*.DS_Store

# ── NuGet ──
*.nupkg
*.snupkg
**/packages/*
!**/packages/build/

# ── 运行时数据（不纳入版本控制） ──
*.db
*.db-shm
*.db-wal
clinic.db

# ── 加密密钥 / 敏感配置（严禁提交版本库） ──
secrets/
*.key
*.pem
secrets.json
appsettings.local.json

# ── 备份文件 ──
Backups/
*.zip
*.bak
clinic.db.bak-*

# ── 日志文件 ──
*.log
crash_*.log
run-*.log
test_*.txt

# ── AI 模型 / 运行时二进制（体积大且可重新下载，不进版本库） ──
*.gguf
src/Clinic.AiScribe/Models/
src/Clinic.AiScribe/tools/

# ── PDF 输出（运行时生成） ──
Pdf/

# ── 临时文件 ──
*.tmp
*.bak
*.cache
*~

# ── 交付报告（构建产物） ──
clinic-delivery-report/
clinic-test-report/
.trae-html-share-packages/
