<Window x:Class="Clinic.Presentation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Clinic.Presentation.ViewModels"
        xmlns:views="clr-namespace:Clinic.Presentation.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="陈医生诊所处方管理系统"
        Height="700" Width="1100"
        MinHeight="650" MinWidth="1000"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:NullToCollapsedConverter x:Key="NullToCollapsed"
                                        xmlns:conv="clr-namespace:Clinic.Presentation.Converters"/>
        <DataTemplate DataType="{x:Type vm:PatientManagementViewModel}">
            <views:PatientManagementView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PrescriptionViewModel}">
            <views:PrescriptionView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BillingViewModel}">
            <views:BillingView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:InventoryViewModel}">
            <views:InventoryView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PrescriptionHistoryViewModel}">
            <views:PrescriptionHistoryView/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ======== 侧边导航栏 ======== -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}"
                BorderBrush="{StaticResource SidebarBorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="0,0">

                <!-- Logo + 系统标题 -->
                <StackPanel DockPanel.Dock="Top" Margin="20,20,20,16">
                    <DockPanel Margin="0,0,0,12">
                        <Border Width="36" Height="36" CornerRadius="8"
                                Background="{StaticResource PrimaryBrush}"
                                DockPanel.Dock="Left" Margin="0,0,10,0">
                            <Path Data="{StaticResource IconMedicalCross}"
                                  Width="20" Height="20" Stretch="Uniform"
                                  Stroke="White" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="陈医生诊所处方管理系统" FontSize="12" FontWeight="Bold"
                                       Foreground="{StaticResource Gray800Brush}"/>
                            <TextBlock Text="Dr. Chen's Clinic" FontSize="9"
                                       Foreground="{StaticResource Gray400Brush}"/>
                        </StackPanel>
                    </DockPanel>
                </StackPanel>

                <!-- 用户信息卡 -->
                <Border DockPanel.Dock="Top" Margin="12,0,12,12"
                        Background="White" CornerRadius="8"
                        BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1"
                        Padding="12,10">
                    <DockPanel>
                        <Border Width="32" Height="32" CornerRadius="16"
                                Background="{StaticResource PrimaryBgBrush}"
                                DockPanel.Dock="Left" Margin="0,0,10,0">
                            <Path Data="{StaticResource IconUserCircle}"
                                  Width="18" Height="18" Stretch="Uniform"
                                  Stroke="{StaticResource PrimaryBrush}" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Button DockPanel.Dock="Right"
                                Style="{StaticResource BtnOutlineSm}"
                                Command="{Binding EditDoctorNameCommand}"
                                Padding="6,2" Margin="0,0,0,0"
                                ToolTip="修改医生姓名"
                                Visibility="{Binding CanPrescribe, Converter={StaticResource BoolToVis}}">
                            <Path Data="{StaticResource IconEdit}"
                                  Width="12" Height="12" Stretch="Uniform"
                                  Stroke="{StaticResource Gray600Brush}" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  VerticalAlignment="Center"/>
                        </Button>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentUserDisplayName}"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource Gray800Brush}"/>
                            <TextBlock Text="{Binding CurrentUserRoleText}"
                                       FontSize="11" Foreground="{StaticResource Gray500Brush}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- 退出登录按钮 -->
                <Button DockPanel.Dock="Bottom"
                        Style="{StaticResource BtnOutline}"
                        Margin="12,8" Padding="0,8"
                        Command="{Binding LogoutCommand}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Path Data="{StaticResource IconLogout}"
                              Width="16" Height="16" Stretch="Uniform"
                              Stroke="{StaticResource Gray600Brush}" StrokeThickness="2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="退出登录" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- 导航菜单 -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="8,4,8,0">
                    <StackPanel>

                        <!-- 处方开具（核心业务，首选入口） -->
                        <Button Style="{StaticResource BtnNav}"
                                Command="{Binding NavigateToPrescriptionCommand}"
                                Visibility="{Binding CanPrescribe, Converter={StaticResource BoolToVis}}"
                                Margin="0,0,0,4">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconClipboardList}"
                                      Width="18" Height="18" Stretch="Uniform"
                                      Stroke="{StaticResource Gray600Brush}" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="处方开具" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 收费管理 -->
                        <Button Style="{StaticResource BtnNav}"
                                Command="{Binding NavigateToBillingCommand}"
                                Margin="0,0,0,4">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconReceipt}"
                                      Width="18" Height="18" Stretch="Uniform"
                                      Stroke="{StaticResource Gray600Brush}" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="收费管理" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 库存管理 -->
                        <Button Style="{StaticResource BtnNav}"
                                Command="{Binding NavigateToInventoryCommand}"
                                Margin="0,0,0,4">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconPackage}"
                                      Width="18" Height="18" Stretch="Uniform"
                                      Stroke="{StaticResource Gray600Brush}" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="库存管理" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 处方查询 -->
                        <Button Style="{StaticResource BtnNav}"
                                Command="{Binding NavigateToPrescriptionHistoryCommand}"
                                Margin="0,0,0,4">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconHistory}"
                                      Width="18" Height="18" Stretch="Uniform"
                                      Stroke="{StaticResource Gray600Brush}" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="处方查询" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 分隔线 -->
                        <Border Height="1" Background="{StaticResource BorderLightBrush}"
                                Margin="4,8,4,8"/>

                        <!-- 患者管理（低频功能，移至分隔线下方） -->
                        <Button Style="{StaticResource BtnNav}"
                                Command="{Binding NavigateToPatientCommand}"
                                Margin="0,0,0,4">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconUsers}"
                                      Width="18" Height="18" Stretch="Uniform"
                                      Stroke="{StaticResource Gray600Brush}" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="患者管理" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 系统工具标题 -->
                        <TextBlock Text="系统工具" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{StaticResource Gray400Brush}"
                                   Margin="12,0,0,4"/>

                        <!-- 数据备份 -->
                        <Button Style="{StaticResource BtnNav}"
                                Command="{Binding CreateBackupCommand}"
                                Margin="0,0,0,4">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconDatabase}"
                                      Width="18" Height="18" Stretch="Uniform"
                                      Stroke="{StaticResource Gray600Brush}" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="数据备份" VerticalAlignment="Center" FontSize="13"/>
                            </StackPanel>
                        </Button>

                        <!-- 数据恢复 -->
                        <Button Style="{StaticResource BtnNav}"
                                Command="{Binding RestoreBackupCommand}"
                                Margin="0,0,0,4">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconDatabaseImport}"
                                      Width="18" Height="18" Stretch="Uniform"
                                      Stroke="{StaticResource Gray600Brush}" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="数据恢复" VerticalAlignment="Center" FontSize="13"/>
                            </StackPanel>
                        </Button>

                        <!-- 审计验证 -->
                        <Button Style="{StaticResource BtnNav}"
                                Command="{Binding VerifyAuditChainCommand}"
                                Margin="0,0,0,4">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconShieldCheck}"
                                      Width="18" Height="18" Stretch="Uniform"
                                      Stroke="{StaticResource Gray600Brush}" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="审计验证" VerticalAlignment="Center" FontSize="13"/>
                            </StackPanel>
                        </Button>

                        <!-- 状态消息 -->
                        <Border Background="{StaticResource SuccessBgBrush}"
                                CornerRadius="6" Padding="10,8" Margin="4,12,4,0"
                                Visibility="{Binding StatusMessage, Converter={StaticResource NullToCollapsed}}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconCircleCheck}"
                                      Width="14" Height="14" Stretch="Uniform"
                                      Stroke="{StaticResource SuccessBrush}" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding StatusMessage}"
                                           Style="{StaticResource TextSuccess}" FontSize="11"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource ErrorBgBrush}"
                                CornerRadius="6" Padding="10,8" Margin="4,4,4,0"
                                Visibility="{Binding ErrorMessage, Converter={StaticResource NullToCollapsed}}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconAlertTriangle}"
                                      Width="14" Height="14" Stretch="Uniform"
                                      Stroke="{StaticResource ErrorBrush}" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding ErrorMessage}"
                                           Style="{StaticResource TextError}" FontSize="11"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ======== 内容区域 ======== -->
        <ContentControl Grid.Column="1"
                        Content="{Binding CurrentViewModel}"/>
    </Grid>
</Window>
