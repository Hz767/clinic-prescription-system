<UserControl x:Class="Clinic.Presentation.Views.PatientManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Clinic.Presentation.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:PatientManagementViewModel}"
             Background="White">
    <UserControl.Resources>
        <conv:NullToCollapsedConverter x:Key="NullToCollapsed"
                                        xmlns:conv="clr-namespace:Clinic.Presentation.Converters"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"
                                        xmlns:conv="clr-namespace:Clinic.Presentation.Converters"/>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 搜索栏 -->
        <DockPanel Grid.Row="0">
            <Button DockPanel.Dock="Right"
                    Style="{StaticResource BtnPrimary}"
                    Command="{Binding SearchCommand}"
                    Margin="8,0,0,0">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconSearch}"
                          Width="16" Height="16" Stretch="Uniform"
                          Stroke="White" StrokeThickness="2"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="搜索" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <TextBox Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"/>
        </DockPanel>

        <!-- 状态/错误消息 -->
        <StackPanel Grid.Row="2">
            <TextBlock Text="{Binding ErrorMessage}"
                       Style="{StaticResource TextError}"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource NullToCollapsed}}"/>
            <TextBlock Text="{Binding StatusMessage}"
                       Style="{StaticResource TextSuccess}"
                       Visibility="{Binding StatusMessage, Converter={StaticResource NullToCollapsed}}"/>
        </StackPanel>

        <!-- 主区域：左列表 + 右表单 -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <!-- 患者列表 -->
            <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Style="{StaticResource TextSectionHeader}"
                                   Text="患者列表"
                                   VerticalAlignment="Center"/>
                        <Button DockPanel.Dock="Right"
                                Style="{StaticResource BtnOutlineSm}"
                                Command="{Binding EditPatientCommand}"
                                Visibility="{Binding SelectedPatient, Converter={StaticResource NullToCollapsed}}"
                                Margin="8,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconEdit}"
                                      Width="12" Height="12" Stretch="Uniform"
                                      Stroke="{StaticResource Gray600Brush}" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="编辑" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </DockPanel>
                    <DataGrid ItemsSource="{Binding Patients}"
                              SelectedItem="{Binding SelectedPatient}"
                              BorderThickness="0"
                              AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="姓名" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="性别" Binding="{Binding Gender}" Width="45"/>
                            <DataGridTextColumn Header="出生日期" Binding="{Binding Dob, StringFormat=yyyy-MM-dd}" Width="90"/>
                            <DataGridTextColumn Header="电话" Binding="{Binding Phone}" Width="110"/>
                            <DataGridTextColumn Header="过敏史" Binding="{Binding Allergies, TargetNullValue='—'}" Width="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#DC2626"/>
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        <Setter Property="ToolTip" Value="{Binding Allergies}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="基础疾病" Binding="{Binding ChronicTags, TargetNullValue='—'}" Width="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        <Setter Property="ToolTip" Value="{Binding ChronicTags}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- 患者 表单（新建/编辑共用） -->
            <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- 标题：根据模式切换 -->
                        <TextBlock Text="新建患者档案"
                                   Style="{StaticResource TextSectionHeader}"
                                   Margin="0,0,0,12"
                                   Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}"/>
                        <TextBlock Text="编辑患者档案"
                                   Style="{StaticResource TextSectionHeader}"
                                   Margin="0,0,0,12"
                                   Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibility}}"/>

                        <TextBlock Style="{StaticResource TextLabel}" Text="姓名 *" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,8"/>

                        <TextBlock Style="{StaticResource TextLabel}" Text="性别" Margin="0,0,0,4"/>
                        <ComboBox Text="{Binding NewGender}"
                                  IsEditable="True" IsReadOnly="True"
                                  Margin="0,0,0,8">
                            <ComboBoxItem Content="男" IsSelected="True"/>
                            <ComboBoxItem Content="女"/>
                        </ComboBox>

                        <TextBlock Style="{StaticResource TextLabel}" Text="出生日期" Margin="0,0,0,4"/>
                        <DatePicker SelectedDate="{Binding NewDob}"
                                    Margin="0,0,0,8"/>

                        <TextBlock Style="{StaticResource TextLabel}" Text="联系电话 *" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding NewPhone, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,2"/>
                        <TextBlock Text="{Binding NewPhoneError}"
                                   FontSize="11" Foreground="#DC2626" Margin="0,0,0,8"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding NewPhoneError, Converter={StaticResource NullToCollapsed}}"/>

                        <!-- LLM 过敏史辅助输入 -->
                        <Border Style="{StaticResource AiPanelBorder}" Margin="0,0,0,8"
                                Visibility="{Binding LlmIsAvailable, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                            <StackPanel>
                                <TextBlock Text="AI 过敏史整理" FontWeight="SemiBold"
                                           Foreground="{StaticResource AiPanelTextBrush}" Margin="0,0,0,4"/>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right"
                                            Style="{StaticResource BtnOutlineSm}"
                                            Content="AI 整理"
                                            Command="{Binding ParseAllergyCommand}"
                                            Margin="4,0,0,0"/>
                                    <TextBox Text="{Binding LlmAllergyInput, UpdateSourceTrigger=PropertyChanged}"/>
                                </DockPanel>
                                <TextBlock Style="{StaticResource TextCaption}"
                                           Text="输入口述过敏史，如「青霉素过敏，吃海鲜起疹子」"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource TextLabel}" Text="过敏史" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding NewAllergies, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,8"
                                 AcceptsReturn="True" TextWrapping="Wrap" Height="50"/>

                        <TextBlock Style="{StaticResource TextLabel}" Text="病史" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding NewHistory, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,8"
                                 AcceptsReturn="True" TextWrapping="Wrap" Height="50"/>

                        <TextBlock Style="{StaticResource TextLabel}" Text="基础疾病" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding NewChronicTags, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,12"
                                 ToolTip="如：高血压、糖尿病、冠心病等慢性病"/>

                        <!-- 新建模式：创建档案按钮 -->
                        <Button Style="{StaticResource BtnPrimaryLg}"
                                Command="{Binding CreatePatientCommand}"
                                Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconUserPlus}"
                                      Width="18" Height="18" Stretch="Uniform"
                                      Stroke="White" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="创建档案" Foreground="White" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 编辑模式：保存修改 + 取消按钮 -->
                        <StackPanel Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibility}}">
                            <Button Style="{StaticResource BtnPrimaryLg}"
                                    Command="{Binding UpdatePatientCommand}"
                                    Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconDeviceFloppy}"
                                          Width="18" Height="18" Stretch="Uniform"
                                          Stroke="White" StrokeThickness="2"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="保存修改" Foreground="White" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource BtnOutline}"
                                    Command="{Binding CancelEditCommand}"
                                    Content="取消编辑"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
