<UserControl x:Class="Clinic.Presentation.Views.BillingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Clinic.Presentation.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:BillingViewModel}"
             Background="White">
    <UserControl.Resources>
        <conv:NullToCollapsedConverter x:Key="NullToCollapsed"
                                        xmlns:conv="clr-namespace:Clinic.Presentation.Converters"/>
        <conv:InverseBooleanConverter x:Key="InverseBool"
                                       xmlns:conv="clr-namespace:Clinic.Presentation.Converters"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"
                                        xmlns:conv="clr-namespace:Clinic.Presentation.Converters"/>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- IsBusy 全局加载指示器 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <ProgressBar IsIndeterminate="True" Width="120" Height="4"
                         HorizontalAlignment="Left"/>
            <TextBlock Text="处理中..." FontSize="{StaticResource FontSizeCaption}"
                       Foreground="{StaticResource PrimaryBrush}"
                       VerticalAlignment="Center" Margin="8,0,0,0"/>
        </StackPanel>

        <!-- ════════════ Tab 控制 ════════════ -->
        <TabControl Grid.Row="2" SelectedIndex="{Binding ActiveTabIndex, Mode=TwoWay}">

            <!-- ── Tab 0: 待办工作台 ── -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconClipboardList}"
                              Width="16" Height="16" Stretch="Uniform"
                              Stroke="{StaticResource PrimaryBrush}" StrokeThickness="2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="待办工作台" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,4,0,8">

                        <!-- 工具栏：刷新 -->
                        <DockPanel Margin="0,0,0,12">
                            <TextBlock Text="待处理处方队列（近30天）" FontSize="{StaticResource FontSizeBody}" FontWeight="SemiBold" Foreground="{StaticResource Gray900Brush}" VerticalAlignment="Center"/>
                            <Button DockPanel.Dock="Right" Style="{StaticResource BtnOutlineSm}"
                                    Command="{Binding LoadPendingWorkbenchCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconRefresh}" Width="12" Height="12" Stretch="Uniform"
                                          Stroke="{StaticResource Gray600Brush}" StrokeThickness="2"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBlock Text="刷新" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </DockPanel>

                        <!-- 三列待办队列 -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 待审核 -->
                            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Background="White">
                                <StackPanel Margin="12">
                                    <DockPanel Margin="0,0,0,8">
                                        <TextBlock Text="待审核" FontSize="{StaticResource FontSizeSmall}" FontWeight="SemiBold" Foreground="#92400E" VerticalAlignment="Center"/>
                                        <Border DockPanel.Dock="Right" Background="{StaticResource WarningBgBrush}" CornerRadius="10" Padding="8,2">
                                            <TextBlock Text="{Binding PendingReviewCount}" FontSize="{StaticResource FontSizeCaption}" FontWeight="Bold" Foreground="#D97706" HorizontalAlignment="Center"/>
                                        </Border>
                                    </DockPanel>
                                    <ItemsControl ItemsSource="{Binding PendingReviewList}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#FFFBEB" CornerRadius="6" Padding="10,8" Margin="0,0,0,8"
                                                        Cursor="Hand" MouseLeftButtonUp="PendingItem_Click">
                                                    <StackPanel>
                                                        <DockPanel>
                                                            <TextBlock Text="{Binding PatientName}" FontSize="{StaticResource FontSizeCaption}" FontWeight="SemiBold" Foreground="#92400E"/>
                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding NoYearSeq}" FontSize="{StaticResource FontSizeMicro}" Foreground="#A8A29E"/>
                                                        </DockPanel>
                                                        <TextBlock Text="{Binding DiagnosisText}" FontSize="{StaticResource FontSizeTiny}" Foreground="#78716C" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                                        <TextBlock Text="{Binding CreatedAt, StringFormat=MM-dd HH:mm}" FontSize="{StaticResource FontSizeMicro}" Foreground="#A8A29E" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="暂无待审核处方" FontSize="{StaticResource FontSizeTiny}" Foreground="{StaticResource TextDisabledBrush}" HorizontalAlignment="Center" Margin="0,12,0,0"
                                               Visibility="{Binding PendingReviewCount, Converter={StaticResource NullToCollapsed}}"/>
                                </StackPanel>
                            </Border>

                            <!-- 待收费 -->
                            <Border Grid.Column="2" Style="{StaticResource CardBorder}" Background="White">
                                <StackPanel Margin="12">
                                    <DockPanel Margin="0,0,0,8">
                                        <TextBlock Text="待收费" FontSize="{StaticResource FontSizeSmall}" FontWeight="SemiBold" Foreground="#5B21B6" VerticalAlignment="Center"/>
                                        <Border DockPanel.Dock="Right" Background="#EDE9FE" CornerRadius="10" Padding="8,2">
                                            <TextBlock Text="{Binding PendingBillingCount}" FontSize="{StaticResource FontSizeCaption}" FontWeight="Bold" Foreground="#7C3AED" HorizontalAlignment="Center"/>
                                        </Border>
                                    </DockPanel>
                                    <ItemsControl ItemsSource="{Binding PendingBillingList}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#F5F3FF" CornerRadius="6" Padding="10,8" Margin="0,0,0,8"
                                                        Cursor="Hand" MouseLeftButtonUp="PendingItem_Click">
                                                    <StackPanel>
                                                        <DockPanel>
                                                            <TextBlock Text="{Binding PatientName}" FontSize="{StaticResource FontSizeCaption}" FontWeight="SemiBold" Foreground="#5B21B6"/>
                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding TotalAmount, StringFormat=¥{0:F2}}" FontSize="{StaticResource FontSizeTiny}" FontWeight="Bold" Foreground="#7C3AED"/>
                                                        </DockPanel>
                                                        <TextBlock Text="{Binding DiagnosisText}" FontSize="{StaticResource FontSizeTiny}" Foreground="#78716C" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                                        <TextBlock Text="{Binding NoYearSeq}" FontSize="{StaticResource FontSizeMicro}" Foreground="#A8A29E" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="暂无待收费处方" FontSize="{StaticResource FontSizeTiny}" Foreground="{StaticResource TextDisabledBrush}" HorizontalAlignment="Center" Margin="0,12,0,0"
                                               Visibility="{Binding PendingBillingCount, Converter={StaticResource NullToCollapsed}}"/>
                                </StackPanel>
                            </Border>

                            <!-- 待发药 -->
                            <Border Grid.Column="4" Style="{StaticResource CardBorder}" Background="White">
                                <StackPanel Margin="12">
                                    <DockPanel Margin="0,0,0,8">
                                        <TextBlock Text="待发药" FontSize="{StaticResource FontSizeSmall}" FontWeight="SemiBold" Foreground="#075985" VerticalAlignment="Center"/>
                                        <Border DockPanel.Dock="Right" Background="#E0F2FE" CornerRadius="10" Padding="8,2">
                                            <TextBlock Text="{Binding PendingDispenseCount}" FontSize="{StaticResource FontSizeCaption}" FontWeight="Bold" Foreground="#0284C7" HorizontalAlignment="Center"/>
                                        </Border>
                                    </DockPanel>
                                    <ItemsControl ItemsSource="{Binding PendingDispenseList}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#F0F9FF" CornerRadius="6" Padding="10,8" Margin="0,0,0,8"
                                                        Cursor="Hand" MouseLeftButtonUp="PendingItem_Click">
                                                    <StackPanel>
                                                        <DockPanel>
                                                            <TextBlock Text="{Binding PatientName}" FontSize="{StaticResource FontSizeCaption}" FontWeight="SemiBold" Foreground="#075985"/>
                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding NoYearSeq}" FontSize="{StaticResource FontSizeMicro}" Foreground="#A8A29E"/>
                                                        </DockPanel>
                                                        <TextBlock Text="{Binding DiagnosisText}" FontSize="{StaticResource FontSizeTiny}" Foreground="#78716C" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                                        <TextBlock Text="{Binding CreatedAt, StringFormat=MM-dd HH:mm}" FontSize="{StaticResource FontSizeMicro}" Foreground="#A8A29E" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="暂无待发药处方" FontSize="{StaticResource FontSizeTiny}" Foreground="{StaticResource TextDisabledBrush}" HorizontalAlignment="Center" Margin="0,12,0,0"
                                               Visibility="{Binding PendingDispenseCount, Converter={StaticResource NullToCollapsed}}"/>
                                </StackPanel>
                            </Border>

                        </Grid>

                        <TextBlock Text="提示：点击任意处方卡片，将自动跳转到「业务办理」并填充对应处方编号" FontSize="{StaticResource FontSizeTiny}" Foreground="{StaticResource TextDisabledBrush}" Margin="0,12,0,0" HorizontalAlignment="Center"/>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ── Tab 1: 业务办理（收费 + 审核 + 发药） ── -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconCash}"
                              Width="16" Height="16" Stretch="Uniform"
                              Fill="{StaticResource PrimaryBrush}"
                              VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="业务办理" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,4,0,8">

                        <!-- 1. 收费登记 -->
                        <Border Style="{StaticResource CardBorder}"
                                Visibility="{Binding CanBill, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="收费登记" Style="{StaticResource TextSectionHeader}" Margin="0,0,0,12"/>

                                <!-- 待收费处方信息卡片（从处方页面跳转时显示） -->
                                <Border Background="#F0FDF4" CornerRadius="6" Padding="12,10" Margin="0,0,0,12"
                                        BorderBrush="#A7F3D0" BorderThickness="1"
                                        Visibility="{Binding HasPendingPrescription, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <TextBlock Text="待收费处方" FontWeight="SemiBold" FontSize="{StaticResource FontSizeCaption}" Foreground="{StaticResource PrimaryDarkBrush}" Margin="0,0,0,6"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="处方编号：" FontSize="{StaticResource FontSizeTiny}" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2"/>
                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding PendingPrescriptionNo, Mode=OneWay}" FontSize="{StaticResource FontSizeTiny}" FontWeight="SemiBold" Margin="0,0,0,2"/>
                                            <TextBlock Grid.Row="0" Grid.Column="3" Text="金额：" FontSize="{StaticResource FontSizeTiny}" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,4,0"/>
                                            <TextBlock Grid.Row="0" Grid.Column="4" Text="{Binding PendingAmount, Mode=OneWay}" FontSize="{StaticResource FontSizeSmall}" FontWeight="Bold" Foreground="{StaticResource ErrorBrush}"/>
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="患者姓名：" FontSize="{StaticResource FontSizeTiny}" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PendingPatientName, Mode=OneWay}" FontSize="{StaticResource FontSizeTiny}" FontWeight="SemiBold" Foreground="{StaticResource PrimaryDarkBrush}" Margin="0,0,0,2"/>
                                            <TextBlock Grid.Row="1" Grid.Column="3" Text="状态：" FontSize="{StaticResource FontSizeTiny}" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,4,0"/>
                                            <TextBlock Grid.Row="1" Grid.Column="4" Text="{Binding PendingStatusText, Mode=OneWay}" FontSize="{StaticResource FontSizeTiny}" Margin="0,0,0,2"/>
                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="诊断：" FontSize="{StaticResource FontSizeTiny}" Foreground="{StaticResource TextMutedBrush}"/>
                                            <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="4" Text="{Binding PendingDiagnosis, Mode=OneWay}" FontSize="{StaticResource FontSizeTiny}" TextTrimming="CharacterEllipsis"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="120"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="10"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="10"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="10"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="12"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- 处方 ID -->
                                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource TextLabel}" Text="处方 ID"
                                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <Grid Grid.Row="0" Grid.Column="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="BillRxIdBox"
                                                 Text="{Binding PrescriptionIdInput, UpdateSourceTrigger=PropertyChanged}"
                                                 VerticalContentAlignment="Center"/>
                                        <Button Grid.Column="1" Content="🔍" Click="SearchPrescription_Click" Tag="0"
                                                Margin="4,0,0,0" Padding="8,0" FontSize="{StaticResource FontSizeTiny}"
                                                ToolTip="搜索处方（按编号/患者/诊断）"/>
                                        <Popup IsOpen="{Binding IsPrescriptionSearchOpen}" StaysOpen="False"
                                               PlacementTarget="{Binding ElementName=BillRxIdBox}" Placement="Bottom"
                                               Width="340">
                                            <Border Background="White" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="4"
                                                    MaxHeight="220">
                                                <ListBox ItemsSource="{Binding PrescriptionSearchResults}"
                                                         SelectionChanged="SearchResult_SelectionChanged">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Margin="6,3">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="{Binding NoYearSeq}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeTiny}"/>
                                                                    <TextBlock Text="{Binding PatientName}" FontSize="{StaticResource FontSizeTiny}" Margin="8,0,0,0"/>
                                                                    <TextBlock Text="{Binding TotalAmount, StringFormat=¥{0:F2}}" FontSize="{StaticResource FontSizeTiny}" Margin="8,0,0,0" Foreground="{StaticResource ErrorBrush}"/>
                                                                </StackPanel>
                                                                <TextBlock Text="{Binding DiagnosisText}" FontSize="{StaticResource FontSizeMicro}" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis"/>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                            </Border>
                                        </Popup>
                                    </Grid>

                                    <!-- 收费方式 -->
                                    <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource TextLabel}" Text="收费方式"
                                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <ComboBox Grid.Row="2" Grid.Column="1"
                                              SelectedIndex="{Binding PaymentMethod}">
                                        <ComboBoxItem Content="现金"/>
                                        <ComboBoxItem Content="POS"/>
                                    </ComboBox>

                                    <!-- 金额 -->
                                    <TextBlock Grid.Row="2" Grid.Column="3" Style="{StaticResource TextLabel}" Text="金额（元）"
                                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBox Grid.Row="2" Grid.Column="4"
                                             Text="{Binding AmountInput, UpdateSourceTrigger=PropertyChanged}"
                                             VerticalContentAlignment="Center"/>

                                    <!-- POS 序列号（仅 POS 显示） -->
                                    <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource TextLabel}" Text="POS 序列号"
                                               VerticalAlignment="Center" Margin="0,0,12,0"
                                               Visibility="{Binding IsPos, Converter={StaticResource BoolToVis}}"/>
                                    <TextBox Grid.Row="4" Grid.Column="1"
                                             Text="{Binding PosSerialNo, UpdateSourceTrigger=PropertyChanged}"
                                             VerticalContentAlignment="Center"
                                             Visibility="{Binding IsPos, Converter={StaticResource BoolToVis}}"/>

                                    <!-- 备注 -->
                                    <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource TextLabel}" Text="备注"
                                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBox Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="4"
                                             Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}"/>

                                    <!-- 按钮 -->
                                    <Button Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="5"
                                            Command="{Binding RecordPaymentCommand}"
                                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                                            Style="{StaticResource BtnPrimaryLg}"
                                            HorizontalAlignment="Right">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconCash}" Fill="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="确认收费" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- 消息区 -->
                                <StackPanel Margin="0,12,0,0">
                                    <TextBlock Text="{Binding ErrorMessage}"
                                               Style="{StaticResource TextError}"
                                               Visibility="{Binding ErrorMessage, Converter={StaticResource NullToCollapsed}}"/>
                                    <TextBlock Text="{Binding StatusMessage}"
                                               Style="{StaticResource TextSuccess}"
                                               Visibility="{Binding StatusMessage, Converter={StaticResource NullToCollapsed}}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 2. 药师审核 -->
                        <Border Margin="0,16,0,0" Style="{StaticResource CardBorder}"
                                Visibility="{Binding CanReview, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="处方审核（《处方管理办法》要求，个人诊所医生可自审）" Style="{StaticResource TextSectionHeader}" Margin="0,0,0,12"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="10"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="10"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="12"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- 处方 ID -->
                                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource TextLabel}" Text="处方 ID"
                                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <Grid Grid.Row="0" Grid.Column="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="ReviewRxIdBox"
                                                 Text="{Binding ReviewPrescriptionIdInput, UpdateSourceTrigger=PropertyChanged}"
                                                 VerticalContentAlignment="Center"/>
                                        <Button Grid.Column="1" Content="🔍" Click="SearchPrescription_Click" Tag="1"
                                                Margin="4,0,0,0" Padding="8,0" FontSize="{StaticResource FontSizeTiny}"
                                                ToolTip="搜索处方（按编号/患者/诊断）"/>
                                        <Popup IsOpen="{Binding IsPrescriptionSearchOpen}" StaysOpen="False"
                                               PlacementTarget="{Binding ElementName=ReviewRxIdBox}" Placement="Bottom"
                                               Width="340">
                                            <Border Background="White" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="4"
                                                    MaxHeight="220">
                                                <ListBox ItemsSource="{Binding PrescriptionSearchResults}"
                                                         SelectionChanged="SearchResult_SelectionChanged">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Margin="6,3">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="{Binding NoYearSeq}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeTiny}"/>
                                                                    <TextBlock Text="{Binding PatientName}" FontSize="{StaticResource FontSizeTiny}" Margin="8,0,0,0"/>
                                                                    <TextBlock Text="{Binding TotalAmount, StringFormat=¥{0:F2}}" FontSize="{StaticResource FontSizeTiny}" Margin="8,0,0,0" Foreground="{StaticResource ErrorBrush}"/>
                                                                </StackPanel>
                                                                <TextBlock Text="{Binding DiagnosisText}" FontSize="{StaticResource FontSizeMicro}" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis"/>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                            </Border>
                                        </Popup>
                                    </Grid>
                                    <Button Grid.Row="0" Grid.Column="3"
                                            Command="{Binding AiPreReviewCommand}"
                                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                                            Style="{StaticResource BtnPrimary}"
                                            Content="智能预审"/>

                                    <!-- 智能预审结果（仅 HasAiReviewResult 为 True 时显示） -->
                                    <TextBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="4"
                                             Text="{Binding AiReviewResult}"
                                             IsReadOnly="True"
                                             TextWrapping="Wrap"
                                             AcceptsReturn="True"
                                             MinHeight="60"
                                             Visibility="{Binding HasAiReviewResult, Converter={StaticResource BoolToVis}}"/>

                                    <!-- 审核备注 -->
                                    <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource TextLabel}" Text="审核备注"
                                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3"
                                             Text="{Binding ReviewNote, UpdateSourceTrigger=PropertyChanged}"/>

                                    <!-- 确认审核按钮 -->
                                    <Button Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="4"
                                            Command="{Binding ReviewPrescriptionCommand}"
                                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                                            Style="{StaticResource BtnPrimaryLg}"
                                            HorizontalAlignment="Right">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="确认审核" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- 消息区 -->
                                <StackPanel Margin="0,12,0,0">
                                    <TextBlock Text="{Binding ErrorMessage}"
                                               Style="{StaticResource TextError}"
                                               Visibility="{Binding ErrorMessage, Converter={StaticResource NullToCollapsed}}"/>
                                    <TextBlock Text="{Binding StatusMessage}"
                                               Style="{StaticResource TextSuccess}"
                                               Visibility="{Binding StatusMessage, Converter={StaticResource NullToCollapsed}}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 3. 发药登记 -->
                        <Border Margin="0,16,0,0" Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="发药登记（药房配药发药，发药时扣减库存）" Style="{StaticResource TextSectionHeader}" Margin="0,0,0,12"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource TextLabel}" Text="处方 ID"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Grid Grid.Row="0" Grid.Column="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="DispenseRxIdBox"
                                                 Text="{Binding DispensePrescriptionIdInput, UpdateSourceTrigger=PropertyChanged}"/>
                                        <Button Grid.Column="1" Content="🔍" Click="SearchPrescription_Click" Tag="2"
                                                Margin="4,0,0,0" Padding="8,0" FontSize="{StaticResource FontSizeTiny}"
                                                ToolTip="搜索处方（按编号/患者/诊断）"/>
                                        <Popup IsOpen="{Binding IsPrescriptionSearchOpen}" StaysOpen="False"
                                               PlacementTarget="{Binding ElementName=DispenseRxIdBox}" Placement="Bottom"
                                               Width="340">
                                            <Border Background="White" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="4"
                                                    MaxHeight="220">
                                                <ListBox ItemsSource="{Binding PrescriptionSearchResults}"
                                                         SelectionChanged="SearchResult_SelectionChanged">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Margin="6,3">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="{Binding NoYearSeq}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeTiny}"/>
                                                                    <TextBlock Text="{Binding PatientName}" FontSize="{StaticResource FontSizeTiny}" Margin="8,0,0,0"/>
                                                                    <TextBlock Text="{Binding TotalAmount, StringFormat=¥{0:F2}}" FontSize="{StaticResource FontSizeTiny}" Margin="8,0,0,0" Foreground="{StaticResource ErrorBrush}"/>
                                                                </StackPanel>
                                                                <TextBlock Text="{Binding DiagnosisText}" FontSize="{StaticResource FontSizeMicro}" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis"/>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                            </Border>
                                        </Popup>
                                    </Grid>
                                    <Button Grid.Row="0" Grid.Column="2"
                                            Content="查询"
                                            Command="{Binding LoadDispensePrescriptionCommand}"
                                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                                            Style="{StaticResource BtnOutline}"
                                            Margin="8,0,0,0"/>

                                    <!-- 待发药处方信息 -->
                                    <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                                                Visibility="{Binding HasDispensePrescription, Converter={StaticResource BoolToVis}}">
                                        <Border Background="#F0FDF4" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="8" Padding="10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="处方编号：" FontSize="{StaticResource FontSizeTiny}" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2"/>
                                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DispensePrescriptionNo, Mode=OneWay}" FontSize="{StaticResource FontSizeTiny}" FontWeight="SemiBold" Margin="0,0,0,2"/>
                                                <TextBlock Grid.Row="0" Grid.Column="2" Text="金额：" FontSize="{StaticResource FontSizeTiny}" Foreground="{StaticResource TextMutedBrush}" Margin="12,0,4,0"/>
                                                <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding DispenseAmount, Mode=OneWay}" FontSize="{StaticResource FontSizeSmall}" FontWeight="Bold" Foreground="{StaticResource ErrorBrush}"/>
                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="患者姓名：" FontSize="{StaticResource FontSizeTiny}" Foreground="{StaticResource TextMutedBrush}"/>
                                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DispensePatientName, Mode=OneWay}" FontSize="{StaticResource FontSizeTiny}" FontWeight="SemiBold" Foreground="{StaticResource PrimaryDarkBrush}"/>
                                                <TextBlock Grid.Row="1" Grid.Column="2" Text="状态：" FontSize="{StaticResource FontSizeTiny}" Foreground="{StaticResource TextMutedBrush}" Margin="12,0,4,0"/>
                                                <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding DispenseStatusText, Mode=OneWay}" FontSize="{StaticResource FontSizeTiny}" FontWeight="SemiBold"/>
                                            </Grid>
                                        </Border>

                                        <Button Style="{StaticResource BtnPrimaryLg}"
                                                Command="{Binding DispenseCommand}"
                                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                                                HorizontalAlignment="Right"
                                                Margin="0,10,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="确认发药（扣减库存）" Foreground="White" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ── Tab 2: 日结报表 ── -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconChartBar}"
                              Width="16" Height="16" Stretch="Uniform"
                              Stroke="{StaticResource PrimaryBrush}" StrokeThickness="2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="日结报表" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Border Style="{StaticResource CardBorder}" Margin="0,4,0,8">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,12">
                                <TextBlock Text="日结报表" Style="{StaticResource TextSectionHeader}"
                                           VerticalAlignment="Center"/>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource TextBodySmall}" Text="日期：" VerticalAlignment="Center"/>
                                    <DatePicker SelectedDate="{Binding ReportDate, Mode=TwoWay}"
                                                Margin="8,0,12,0" Width="140"/>
                                    <Button Content="查询"
                                            Command="{Binding LoadDailyReportCommand}"
                                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                                            Style="{StaticResource BtnPrimary}"/>
                                </StackPanel>
                            </DockPanel>

                            <!-- 报表数据卡片 -->
                            <Grid Margin="0,4,0,0"
                                  Visibility="{Binding HasReportData, Converter={StaticResource BoolToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- 处方数 -->
                                <Border Grid.Column="0" Style="{StaticResource StatCardBorder}" Background="{StaticResource SuccessBgBrush}" Margin="0,0,8,0">
                                    <StackPanel Margin="12,10" HorizontalAlignment="Center">
                                        <TextBlock Text="处方数" Style="{StaticResource TextCaption}"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding ReportPrescriptionCount}"
                                                   FontSize="{StaticResource FontSizeTitle}" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}"
                                                   HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- 总金额 -->
                                <Border Grid.Column="1" Style="{StaticResource StatCardBorder}" Background="{StaticResource SecondaryBgBrush}" Margin="0,0,8,0">
                                    <StackPanel Margin="12,10" HorizontalAlignment="Center">
                                        <TextBlock Text="总金额" Style="{StaticResource TextCaption}"
                                                   HorizontalAlignment="Center"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                                            <TextBlock Text="¥" FontSize="{StaticResource FontSizeBody}" Foreground="{StaticResource SecondaryBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding ReportTotalAmount, StringFormat=F2}"
                                                       FontSize="{StaticResource FontSizeTitle}" FontWeight="Bold" Foreground="{StaticResource SecondaryBrush}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- 现金 -->
                                <Border Grid.Column="2" Style="{StaticResource StatCardBorder}" Background="{StaticResource WarningBgBrush}" Margin="0,0,8,0">
                                    <StackPanel Margin="12,10" HorizontalAlignment="Center">
                                        <TextBlock Text="现金" Style="{StaticResource TextCaption}"
                                                   HorizontalAlignment="Center"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                                            <TextBlock Text="¥" FontSize="{StaticResource FontSizeBody}" Foreground="{StaticResource WarningBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding ReportCashAmount, StringFormat=F2}"
                                                       FontSize="{StaticResource FontSizeTitle}" FontWeight="Bold" Foreground="{StaticResource WarningBrush}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- POS -->
                                <Border Grid.Column="3" Style="{StaticResource StatCardBorder}" Background="#F5F3FF">
                                    <StackPanel Margin="12,10" HorizontalAlignment="Center">
                                        <TextBlock Text="POS" Style="{StaticResource TextCaption}"
                                                   HorizontalAlignment="Center"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                                            <TextBlock Text="¥" FontSize="{StaticResource FontSizeBody}" Foreground="#7C3AED" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding ReportPosAmount, StringFormat=F2}"
                                                       FontSize="{StaticResource FontSizeTitle}" FontWeight="Bold" Foreground="#7C3AED"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <!-- ── Tab 3: 收费流水 ── -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconReceipt}"
                              Width="16" Height="16" Stretch="Uniform"
                              Stroke="{StaticResource PrimaryBrush}" StrokeThickness="2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="收费流水" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Border Style="{StaticResource CardBorder}" Margin="0,4,0,8">
                        <StackPanel>
                            <TextBlock Text="收费流水查询" Style="{StaticResource TextSectionHeader}" Margin="0,0,0,12"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBlock Style="{StaticResource TextBodySmall}" Text="从 " VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <DatePicker SelectedDate="{Binding HistoryFromDate, Mode=TwoWay}" Width="140" Margin="0,0,8,0"/>
                                <TextBlock Style="{StaticResource TextBodySmall}" Text="到 " VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <DatePicker SelectedDate="{Binding HistoryToDate, Mode=TwoWay}" Width="140" Margin="0,0,8,0"/>
                                <Button Content="查询"
                                        Command="{Binding LoadPaymentHistoryCommand}"
                                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                                        Style="{StaticResource BtnPrimary}"/>
                            </StackPanel>
                            <DataGrid EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ItemsSource="{Binding PaymentHistory}"
                                      SelectedItem="{Binding SelectedPaymentRecord}"
                                      GridLinesVisibility="Horizontal"
                                      MaxHeight="400"
                                      VerticalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="流水号" Binding="{Binding Id}" Width="60"/>
                                    <DataGridTextColumn Header="处方编号" Binding="{Binding PrescriptionNo}" Width="120"/>
                                    <DataGridTextColumn Header="收费方式" Binding="{Binding MethodText}" Width="80"/>
                                    <DataGridTextColumn Header="金额" Binding="{Binding Amount, StringFormat=C}" Width="80"/>
                                    <DataGridTextColumn Header="收费时间" Binding="{Binding OccurredAt, StringFormat=yyyy-MM-dd HH:mm}" Width="140"/>
                                    <DataGridTextColumn Header="POS序列号" Binding="{Binding PosSerialNo}" Width="120"/>
                                    <DataGridTextColumn Header="备注" Binding="{Binding Note}" Width="*"/>
                                    <DataGridTextColumn Header="冲正" Binding="{Binding IsReversal}" Width="50"/>
                                    <!-- 退费按钮列（仅非冲正记录可见） -->
                                    <DataGridTemplateColumn Header="操作" Width="70">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="退费"
                                                        Style="{StaticResource BtnDanger}"
                                                        FontSize="{StaticResource FontSizeTiny}" Padding="8,2"
                                                        Command="{Binding DataContext.RefundCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"
                                                        Visibility="{Binding IsReversal, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>

        </TabControl>
    </Grid>
</UserControl>
