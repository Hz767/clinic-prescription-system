<Window x:Class="Clinic.Presentation.Views.EditNameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="修改医生姓名"
        Width="360" Height="200"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F9FAFB"
        ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="请输入医生姓名（用于处方签名显示）"
                   FontSize="12" Foreground="#374151"/>

        <TextBox Grid.Row="2" x:Name="NameInput"
                 FontSize="14" Padding="8,6"
                 VerticalContentAlignment="Center"/>

        <TextBlock Grid.Row="4" x:Name="ErrorText"
                   FontSize="11" Foreground="#DC2626"
                   Visibility="Collapsed"/>

        <StackPanel Grid.Row="6" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="取消" Width="72" Height="32"
                    Margin="0,0,8,0"
                    IsCancel="True"
                    Click="Cancel_Click"/>
            <Button Content="确定" Width="72" Height="32"
                    IsDefault="True"
                    Background="#0D9488" Foreground="White"
                    BorderThickness="0"
                    Click="Confirm_Click"/>
        </StackPanel>
    </Grid>
</Window>
