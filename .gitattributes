# 自动检测文本文件并规范化行尾
* text=auto eol=lf

# C# 源文件
*.cs text eol=lf diff=csharp
*.csproj text eol=lf
*.sln text eol=lf
*.props text eol=lf
*.targets text eol=lf

# XAML / XML / 配置
*.xaml text eol=lf
*.xml text eol=lf
*.json text eol=lf
*.config text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# 文档
*.md text eol=lf
*.txt text eol=lf

# SQL
*.sql text eol=lf

# 脚本
*.sh text eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制文件（不转换行尾）
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text eol=lf
*.pdf binary
*.zip binary
*.nupkg binary
*.db binary
*.db-shm binary
*.db-wal binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary

# Visual Studio
*.suo binary
*.user binary
*.userosscache binary
*.sln.docstates binary
