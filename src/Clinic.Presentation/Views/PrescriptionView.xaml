<UserControl x:Class="Clinic.Presentation.Views.PrescriptionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Clinic.Presentation.ViewModels"
             xmlns:controls="clr-namespace:Clinic.Presentation.Controls"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:PrescriptionViewModel}"
             Background="{StaticResource SurfaceDarkBrush}"
             Loaded="PrescriptionView_Loaded">
    <UserControl.Resources>
        <conv:NullToCollapsedConverter x:Key="NullToCollapsed"
                                        xmlns:conv="clr-namespace:Clinic.Presentation.Converters"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"
                                        xmlns:conv="clr-namespace:Clinic.Presentation.Converters"/>
        <conv:DecimalInputConverter x:Key="DecimalInput"
                                     xmlns:conv="clr-namespace:Clinic.Presentation.Converters"/>
        <x:Array x:Key="DoseUnits" Type="sys:String"
                 xmlns:sys="clr-namespace:System;assembly=System.Runtime">
            <sys:String>片</sys:String>
            <sys:String>粒</sys:String>
            <sys:String>袋</sys:String>
            <sys:String>支</sys:String>
            <sys:String>瓶</sys:String>
            <sys:String>mg</sys:String>
            <sys:String>ml</sys:String>
        </x:Array>
        <x:Array x:Key="Frequencies" Type="sys:String"
                 xmlns:sys="clr-namespace:System;assembly=System.Runtime">
            <sys:String>每日一次</sys:String>
            <sys:String>每日两次</sys:String>
            <sys:String>每日三次</sys:String>
            <sys:String>每晚一次</sys:String>
            <sys:String>必要时</sys:String>
        </x:Array>
        <x:Array x:Key="Routes" Type="sys:String"
                 xmlns:sys="clr-namespace:System;assembly=System.Runtime">
            <sys:String>口服</sys:String>
            <sys:String>外用</sys:String>
            <sys:String>静脉注射</sys:String>
            <sys:String>肌肉注射</sys:String>
            <sys:String>吸入</sys:String>
            <sys:String>含服</sys:String>
        </x:Array>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ════════════════ 顶部：当前患者信息条（横跨，已选患者时显示） ════════════════ -->
        <Border Grid.Row="0"
                Visibility="{Binding SelectedPatient, Converter={StaticResource NullToCollapsed}}"
                Background="White" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,0,0,1"
                Padding="16,10">
            <DockPanel>
                <!-- 右侧操作 -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource BtnOutlineSm}"
                            Content="清除患者"
                            Command="{Binding SelectPatientCommand}"
                            CommandParameter="{x:Null}"/>
                </StackPanel>
                <!-- 患者信息 -->
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding SelectedPatient.Name, Mode=OneWay}"
                                   FontSize="{StaticResource FontSizeSubtitle}" FontWeight="Bold" Foreground="{StaticResource Gray900Brush}"
                                   VerticalAlignment="Center"/>
                        <Border Background="{StaticResource PrimaryBgBrush}" CornerRadius="4" Padding="6,2" Margin="8,0,0,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectedPatientAgeText, Mode=OneWay}"
                                       FontSize="{StaticResource FontSizeTiny}" Foreground="{StaticResource PrimaryDarkBrush}"/>
                        </Border>
                        <TextBlock Text="{Binding SelectedPatient.Gender, Mode=OneWay}"
                                   FontSize="{StaticResource FontSizeCaption}" Foreground="{StaticResource TextMutedBrush}" Margin="8,0,0,0"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding SelectedPatient.Phone, Mode=OneWay}"
                                   FontSize="{StaticResource FontSizeCaption}" Foreground="{StaticResource TextMutedBrush}" Margin="12,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <!-- 过敏史 -->
                        <StackPanel Orientation="Horizontal" Visibility="{Binding HasAllergy, Converter={StaticResource BoolToVisibility}}">
                            <Border Background="#FEF2F2" CornerRadius="4" Padding="6,2">
                                <TextBlock FontSize="{StaticResource FontSizeTiny}">
                                    <Run Text="过敏：" Foreground="#991B1B"/>
                                    <Run Text="{Binding SelectedPatientAllergyText, Mode=OneWay}" Foreground="{StaticResource ErrorBrush}" FontWeight="SemiBold"/>
                                </TextBlock>
                            </Border>
                        </StackPanel>
                        <!-- 基础疾病 -->
                        <StackPanel Orientation="Horizontal" Visibility="{Binding HasChronic, Converter={StaticResource BoolToVisibility}}" Margin="8,0,0,0">
                            <Border Background="#FFFBEB" CornerRadius="4" Padding="6,2">
                                <TextBlock FontSize="{StaticResource FontSizeTiny}">
                                    <Run Text="慢病：" Foreground="#92400E"/>
                                    <Run Text="{Binding SelectedPatientChronicText, Mode=OneWay}" Foreground="#B45309"/>
                                </TextBlock>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ════════════════ 中间内容区（左右两栏） ════════════════ -->
        <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="6"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ════════════════ 左侧：输入面板 ════════════════ -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Background="White">
            <StackPanel Margin="12">

                <!-- ── 患者搜索（AutoCompleteTextBox 带防抖） ── -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="患者搜索" Style="{StaticResource TextSectionHeader}" Margin="0,0,0,8"/>
                        <TextBlock Text="输入姓名或手机号，自动联想匹配" Style="{StaticResource TextCaption}" Margin="0,0,0,6"/>

                        <controls:AutoCompleteTextBox
                            x:Name="PatientSearchBox"
                            Text="{Binding PatientSearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                            ItemsSource="{Binding FilteredPatients}"
                            SelectedItem="{Binding SelectedPatient, Mode=TwoWay}"
                            IsDropDownOpen="{Binding ShowPatientDropdown, Mode=TwoWay}"
                            MinSearchLength="1">
                            <controls:AutoCompleteTextBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock FontWeight="SemiBold">
                                                <Run Text="{Binding Name, Mode=OneWay}"/>
                                                <Run Text="  " FontSize="{StaticResource FontSizeMicro}"/>
                                                <Run Text="{Binding Gender, Mode=OneWay}" FontSize="{StaticResource FontSizeTiny}" Foreground="{StaticResource TextMutedBrush}"/>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Phone}" FontSize="{StaticResource FontSizeTiny}" Foreground="{StaticResource TextMutedBrush}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                                   FontSize="9" Foreground="{StaticResource TextMutedBrush}"
                                                   Text="{Binding ChronicTags}"/>
                                    </Grid>
                                </DataTemplate>
                            </controls:AutoCompleteTextBox.ItemTemplate>
                        </controls:AutoCompleteTextBox>

                        <!-- 新建患者档案按钮（始终可见） -->
                        <Button Style="{StaticResource BtnOutlineSm}"
                                Command="{Binding ToggleQuickRegistrationCommand}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                Margin="0,6,0,0" Padding="8,4">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"
                                      Width="12" Height="12" Stretch="Uniform" Margin="0,0,4,0"
                                      VerticalAlignment="Center"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                <TextBlock Text="新建患者档案" VerticalAlignment="Center" FontSize="{StaticResource FontSizeTiny}"/>
                            </StackPanel>
                        </Button>

                        <Border Visibility="{Binding IsQuickRegistration, Converter={StaticResource BoolToVisibility}}"
                                Background="{StaticResource Gray50Brush}" CornerRadius="6" Padding="12,10" Margin="0,6,0,0"
                                BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="快速建档" FontWeight="SemiBold" FontSize="{StaticResource FontSizeSmall}" Margin="0,0,0,8"/>

                                <!-- 姓名 + 性别 -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="姓名" FontSize="{StaticResource FontSizeTiny}" Foreground="{StaticResource TextMutedBrush}"
                                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBox Grid.Column="1"
                                             Text="{Binding NewPatientName, UpdateSourceTrigger=PropertyChanged}"
                                             VerticalContentAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="性别" FontSize="{StaticResource FontSizeTiny}" Foreground="{StaticResource TextMutedBrush}"
                                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <ComboBox Grid.Column="4"
                                              SelectedValue="{Binding NewPatientGender, Mode=TwoWay}"
                                              SelectedValuePath="Content"
                                              VerticalContentAlignment="Center">
                                        <ComboBoxItem Content="男"/>
                                        <ComboBoxItem Content="女"/>
                                    </ComboBox>
                                </Grid>

                                <!-- 手机号 -->
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="手机号" FontSize="{StaticResource FontSizeTiny}" Foreground="{StaticResource TextMutedBrush}"
                                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBox Grid.Column="1"
                                             Text="{Binding NewPatientPhone, UpdateSourceTrigger=PropertyChanged}"
                                             VerticalContentAlignment="Center"/>
                                </Grid>
                                <!-- 手机号验证错误提示 -->
                                <TextBlock Text="{Binding NewPatientPhoneError}"
                                           FontSize="{StaticResource FontSizeMicro}" Foreground="{StaticResource ErrorBrush}" Margin="44,2,0,0"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding NewPatientPhoneError, Converter={StaticResource NullToCollapsed}}"/>

                                <!-- 出生日期 -->
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="出生日期" FontSize="{StaticResource FontSizeTiny}" Foreground="{StaticResource TextMutedBrush}"
                                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <DatePicker Grid.Column="1"
                                                SelectedDate="{Binding NewPatientDob, Mode=TwoWay}"
                                                VerticalContentAlignment="Center"
                                                Height="28"
                                                Language="zh-CN"/>
                                </Grid>

                                <!-- 过敏史 -->
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="过敏史" FontSize="{StaticResource FontSizeTiny}" Foreground="{StaticResource TextMutedBrush}"
                                               VerticalAlignment="Top" Margin="0,4,6,0"/>
                                    <TextBox Grid.Column="1"
                                             Text="{Binding NewPatientAllergies, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             VerticalContentAlignment="Center"
                                             ToolTip="如有药物过敏请填写，如：青霉素、磺胺类"
                                             Height="28"/>
                                </Grid>

                                <!-- 基础疾病（慢病史） -->
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="基础疾病" FontSize="{StaticResource FontSizeTiny}" Foreground="{StaticResource TextMutedBrush}"
                                               VerticalAlignment="Top" Margin="0,4,6,0"/>
                                    <TextBox Grid.Column="1"
                                             Text="{Binding NewPatientChronicTags, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             VerticalContentAlignment="Center"
                                             ToolTip="如有慢性病请填写，如：高血压、糖尿病、冠心病"
                                             Height="28"/>
                                </Grid>

                                <DockPanel Margin="0,8,0,0">
                                    <Button DockPanel.Dock="Right"
                                            Style="{StaticResource BtnPrimarySm}"
                                            Content="确认建档并选择"
                                            Command="{Binding CreateNewPatientCommand}"/>
                                    <Button Style="{StaticResource BtnOutlineSm}"
                                            Content="取消"
                                            Command="{Binding ToggleQuickRegistrationCommand}"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ── 历史病历（选中患者后自动展示，帮助医生快速了解病史） ── -->
                <Border Style="{StaticResource CardBorder}" Margin="0,10,0,0"
                        Visibility="{Binding HasPatientHistory, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <!-- 可折叠标题 -->
                        <DockPanel>
                            <ToggleButton DockPanel.Dock="Right" IsChecked="{Binding IsHistoryExpanded, Mode=TwoWay}"
                                          FontSize="{StaticResource FontSizeMicro}" Padding="4,0" Background="Transparent" BorderThickness="0" Cursor="Hand">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton">
                                        <Setter Property="Content" Value="▶"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter Property="Content" Value="▼"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ToggleButton.Style>
                            </ToggleButton>
                            <TextBlock Text="历史病历" Style="{StaticResource TextSectionHeader}"/>
                        </DockPanel>
                        <!-- 折叠内容 -->
                        <StackPanel Visibility="{Binding IsHistoryExpanded, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="该患者近期就诊记录（最多10条）" Style="{StaticResource TextCaption}" Margin="0,0,0,6"/>
                        <ItemsControl ItemsSource="{Binding PatientHistory}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource Gray50Brush}" CornerRadius="4" Padding="8,6" Margin="0,0,0,4"
                                            BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1">
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" FontSize="{StaticResource FontSizeTiny}" Foreground="{StaticResource TextMutedBrush}"
                                                           VerticalAlignment="Center"
                                                           Text="{Binding CreatedAt, StringFormat='yyyy-MM-dd HH:mm'}"/>
                                                <TextBlock FontSize="{StaticResource FontSizeCaption}" FontWeight="SemiBold" Foreground="{StaticResource PrimaryDarkBrush}">
                                                    <Run Text="{Binding NoYearSeq, Mode=OneWay}"/>
                                                </TextBlock>
                                            </DockPanel>
                                            <TextBlock FontSize="{StaticResource FontSizeTiny}" Foreground="{StaticResource Gray700Brush}" Margin="0,2,0,0"
                                                       Text="{Binding DiagnosisText}"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxWidth="280"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <TextBlock FontSize="{StaticResource FontSizeMicro}" Foreground="{StaticResource TextMutedBrush}">
                                                    <Run Text="{Binding DoctorName, Mode=OneWay}"/>
                                                    <Run Text=" | "/>
                                                    <Run Text="{Binding ItemCount, Mode=OneWay}"/>
                                                    <Run Text="种药品 | ¥"/>
                                                    <Run Text="{Binding TotalAmount, Mode=OneWay, StringFormat=F2}"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ── 药品选择 ── -->
                <Border Style="{StaticResource CardBorder}" Margin="0,10,0,0">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="药品选择" Style="{StaticResource TextSectionHeader}" VerticalAlignment="Center"/>
                            <Border DockPanel.Dock="Right" Style="{StaticResource AiPanelBorder}" Margin="8,0,0,0"
                                    Visibility="{Binding LlmIsAvailable, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right"
                                            Style="{StaticResource BtnOutlineSm}"
                                            Content="AI整理"
                                            Command="{Binding ParsePrescriptionCommand}"
                                            Margin="4,0,0,0"/>
                                    <TextBox Text="{Binding LlmPrescriptionInput, UpdateSourceTrigger=PropertyChanged}"
                                             Height="24" Width="200" FontSize="{StaticResource FontSizeTiny}"
                                             VerticalContentAlignment="Center"
                                             ToolTip="支持一次输入多种药品，如「阿莫西林胶囊 0.5g 一天三次吃三天；布洛芬 0.3g 一天两次吃五天」"/>
                                </DockPanel>
                            </Border>
                        </DockPanel>

                        <DockPanel Margin="0,0,0,6">
                            <ComboBox DockPanel.Dock="Left" SelectedIndex="{Binding DrugCategoryFilter}"
                                      Width="110" Margin="0,0,8,0" VerticalContentAlignment="Center"
                                      ToolTip="按药品分类筛选">
                                <ComboBoxItem Content="全部药品"/>
                                <ComboBoxItem Content="抗菌药"/>
                                <ComboBoxItem Content="特殊管理"/>
                                <ComboBoxItem Content="低库存"/>
                            </ComboBox>
                            <TextBlock DockPanel.Dock="Left" Text="🔍" FontSize="{StaticResource FontSizeSmall}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox Text="{Binding DrugFilter, UpdateSourceTrigger=PropertyChanged}"
                                     VerticalContentAlignment="Center"
                                     AutomationProperties.Name="药品搜索"
                                     ToolTip="输入药品名称或规格进行模糊搜索"/>
                        </DockPanel>

                        <DataGrid EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" x:Name="DrugDataGrid"
                                  ItemsSource="{Binding Drugs}"
                                  SelectedItem="{Binding SelectedDrug}"
                                  IsReadOnly="True"
                                  SelectionMode="Single"
                                  AutoGenerateColumns="False"
                                  Height="520"
                                  MouseDoubleClick="DrugDataGrid_MouseDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="药品名称" Binding="{Binding GenericNameCn}" Width="*"/>
                                <DataGridTextColumn Header="规格" Binding="{Binding Spec}" Width="80"/>
                                <DataGridTextColumn Header="单位" Binding="{Binding Unit}" Width="50"/>
                                <DataGridTextColumn Header="单价" Binding="{Binding RetailPriceRef, StringFormat=F2}" Width="70"/>
                                <DataGridTemplateColumn Header="库存" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding AvailableQty, StringFormat={}{0:0.##}}" FontSize="{StaticResource FontSizeCaption}"/>
                                                <TextBlock Text=" 低库存" FontSize="{StaticResource FontSizeTiny}" FontWeight="SemiBold" Foreground="{StaticResource ErrorBrush}"
                                                           Visibility="{Binding IsLowStock, Converter={StaticResource BoolToVisibility}}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="提示：双击药品行可快速添加到处方明细，用法用量可在右侧处方单中直接修改"
                                   Style="{StaticResource TextCaption}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="{StaticResource Gray200Brush}"/>

        <!-- ════════════════ 右侧：模拟病历单 + 处方单 ════════════════ -->
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Background="{StaticResource SurfaceDarkBrush}">
            <StackPanel Margin="12">

                <!-- ── 门诊病历（医生核心工作区：主诉/病史/体征/诊断一站式输入） ── -->
                <Border Background="White" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="2"
                        Margin="0,0,0,10">
                    <StackPanel Margin="16,12">
                        <!-- 病历标题 + 操作栏 -->
                        <DockPanel Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                <!-- 处方类型 -->
                                <TextBlock Text="处方类型:" VerticalAlignment="Center" FontSize="{StaticResource FontSizeTiny}" Margin="0,0,4,0"/>
                                <ComboBox SelectedIndex="{Binding PrescriptionType}" Width="80" FontSize="{StaticResource FontSizeTiny}"
                                          VerticalContentAlignment="Center">
                                    <ComboBoxItem Content="普通"/>
                                    <ComboBoxItem Content="急诊"/>
                                    <ComboBoxItem Content="儿科"/>
                                </ComboBox>
                                <!-- AI辅助编写病历按钮 -->
                                <Button Style="{StaticResource BtnOutlineSm}"
                                        Content="✨ AI辅助编写"
                                        Command="{Binding GenerateMedicalRecordCommand}"
                                        Visibility="{Binding LlmIsAvailable, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}"
                                        Margin="8,0,0,0"
                                        ToolTip="根据主诉和诊断，AI生成规范病历内容"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="陈医生诊所" FontSize="{StaticResource FontSizeBody}" FontWeight="Bold"
                                           FontFamily="Microsoft YaHei"/>
                                <TextBlock Text="门 诊 病 历" FontSize="{StaticResource FontSizeSubtitle}" FontWeight="Bold"
                                           Margin="0,2,0,0" FontFamily="Microsoft YaHei"/>
                            </StackPanel>
                        </DockPanel>
                        <Line X1="0" Y1="0" X2="1" Y2="0" Stretch="Fill" Stroke="#9CA3AF" StrokeThickness="1" Margin="0,0,0,8"/>

                        <!-- 患者基本信息 -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="姓名：" FontSize="{StaticResource FontSizeTiny}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding SelectedPatient.Name, FallbackValue='—'}" FontSize="{StaticResource FontSizeTiny}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="性别：" FontSize="{StaticResource FontSizeTiny}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            <TextBlock Grid.Column="3" Text="{Binding SelectedPatient.Gender, FallbackValue='—'}" FontSize="{StaticResource FontSizeTiny}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="4" Text="电话：" FontSize="{StaticResource FontSizeTiny}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            <TextBlock Grid.Column="5" Text="{Binding SelectedPatient.Phone, FallbackValue='—'}" FontSize="{StaticResource FontSizeTiny}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="6" Text="日期：" FontSize="{StaticResource FontSizeTiny}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            <TextBlock Grid.Column="7" Text="{Binding Source={x:Static sys:DateTime.Now}, StringFormat='yyyy-MM-dd'}" FontSize="{StaticResource FontSizeTiny}" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- 主诉 -->
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="主  诉：" FontSize="{StaticResource FontSizeTiny}" VerticalAlignment="Top" Margin="0,4,0,0"/>
                            <TextBox Grid.Column="1" x:Name="ChiefComplaintTextBox"
                                     Text="{Binding ChiefComplaint, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="{StaticResource FontSizeTiny}" BorderThickness="0,0,0,1" BorderBrush="{StaticResource BorderDefaultBrush}"
                                     Background="Transparent" Padding="0,2"
                                     MinHeight="24" VerticalContentAlignment="Center"
                                     GotFocus="ChiefComplaintTextBox_GotFocus"
                                     LostFocus="ChiefComplaintTextBox_LostFocus"
                                     ToolTip="点击输入时显示常见主诉快捷选择"/>
                        </Grid>

                        <!-- 主诉悬浮辅助工具栏 -->
                        <Popup x:Name="ChiefComplaintPopup" PlacementTarget="{Binding ElementName=ChiefComplaintTextBox}"
                               Placement="Bottom" HorizontalOffset="-50" VerticalOffset="2"
                               StaysOpen="True" AllowsTransparency="True" PopupAnimation="Fade">
                            <Border Background="White" BorderBrush="#10B981" BorderThickness="1" CornerRadius="8"
                                    Padding="10,8" MaxWidth="420">
                                <StackPanel>
                                    <TextBlock Text="常见主诉（点击添加）" FontSize="{StaticResource FontSizeMicro}" FontWeight="SemiBold"
                                               Foreground="{StaticResource SuccessBrush}" Margin="0,0,0,6"/>
                                    <ItemsControl ItemsSource="{Binding CommonChiefComplaints}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Content="{Binding}"
                                                        Style="{StaticResource BtnTag}"
                                                        Click="ChiefComplaintTag_Click"
                                                        Margin="0,0,6,6"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Popup>

                        <!-- 病史/处置（AI生成病历，可编辑） -->
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="病  史：" FontSize="{StaticResource FontSizeTiny}" VerticalAlignment="Top" Margin="0,4,0,0"/>
                            <StackPanel Grid.Column="1">
                                <TextBox Text="{Binding AiDiagnosisResult, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                                         FontSize="{StaticResource FontSizeTiny}" BorderThickness="0,0,0,1" BorderBrush="{StaticResource BorderDefaultBrush}"
                                         Background="Transparent" Padding="0,2"
                                         AcceptsReturn="True" TextWrapping="Wrap"
                                         MinHeight="50" MaxHeight="120"
                                         VerticalScrollBarVisibility="Auto"
                                         ToolTip="AI辅助生成病历内容，可直接编辑"/>
                                <!-- AI结果操作按钮 -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0"
                                            Visibility="{Binding HasAiDiagnosisResult, Converter={StaticResource BoolToVisibility}}">
                                    <Button Style="{StaticResource BtnOutlineSm}"
                                            Content="放弃AI结果"
                                            Command="{Binding ClearAiDiagnosisCommand}"
                                            Margin="0,0,6,0" FontSize="{StaticResource FontSizeMicro}"/>
                                    <Button Style="{StaticResource BtnPrimarySm}"
                                            Content="确认使用"
                                            Command="{Binding ConfirmAiDiagnosisCommand}"
                                            FontSize="{StaticResource FontSizeMicro}"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <!-- 体征（可直接输入，保存到处方记录） -->
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="体  征：" FontSize="{StaticResource FontSizeTiny}" VerticalAlignment="Top" Margin="0,4,0,0"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock Text="T " FontSize="{StaticResource FontSizeTiny}" VerticalAlignment="Center"/>
                                <TextBox Text="{Binding PatientTemperature, UpdateSourceTrigger=LostFocus, TargetNullValue=''}"
                                         FontSize="{StaticResource FontSizeTiny}" Width="45" Height="22" Padding="2,0"
                                         AutomationProperties.Name="体温"
                                         VerticalContentAlignment="Center" BorderThickness="0,0,0,1" BorderBrush="{StaticResource BorderDefaultBrush}"/>
                                <TextBlock Text="°C  P " FontSize="{StaticResource FontSizeTiny}" VerticalAlignment="Center"/>
                                <TextBox Text="{Binding PatientHeartRate, UpdateSourceTrigger=LostFocus, TargetNullValue=''}"
                                         FontSize="{StaticResource FontSizeTiny}" Width="40" Height="22" Padding="2,0"
                                         AutomationProperties.Name="心率"
                                         VerticalContentAlignment="Center" BorderThickness="0,0,0,1" BorderBrush="{StaticResource BorderDefaultBrush}"/>
                                <TextBlock Text="次/分  BP " FontSize="{StaticResource FontSizeTiny}" VerticalAlignment="Center"/>
                                <TextBox Text="{Binding PatientSystolicBP, UpdateSourceTrigger=LostFocus, TargetNullValue=''}"
                                         FontSize="{StaticResource FontSizeTiny}" Width="35" Height="22" Padding="2,0"
                                         AutomationProperties.Name="收缩压"
                                         VerticalContentAlignment="Center" BorderThickness="0,0,0,1" BorderBrush="{StaticResource BorderDefaultBrush}"/>
                                <TextBlock Text="/" FontSize="{StaticResource FontSizeTiny}" VerticalAlignment="Center"/>
                                <TextBox Text="{Binding PatientDiastolicBP, UpdateSourceTrigger=LostFocus, TargetNullValue=''}"
                                         FontSize="{StaticResource FontSizeTiny}" Width="35" Height="22" Padding="2,0"
                                         AutomationProperties.Name="舒张压"
                                         VerticalContentAlignment="Center" BorderThickness="0,0,0,1" BorderBrush="{StaticResource BorderDefaultBrush}"/>
                                <TextBlock Text="mmHg  Wt " FontSize="{StaticResource FontSizeTiny}" VerticalAlignment="Center"/>
                                <TextBox Text="{Binding PatientWeight, UpdateSourceTrigger=LostFocus, TargetNullValue=''}"
                                         FontSize="{StaticResource FontSizeTiny}" Width="40" Height="22" Padding="2,0"
                                         AutomationProperties.Name="体重"
                                         VerticalContentAlignment="Center" BorderThickness="0,0,0,1" BorderBrush="{StaticResource BorderDefaultBrush}"/>
                                <TextBlock Text="kg" FontSize="{StaticResource FontSizeTiny}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <!-- 体征异常警告 -->
                        <Border Margin="0,4,0,0" CornerRadius="4" Padding="6,4"
                                Visibility="{Binding HasVitalSignsWarning, Converter={StaticResource BoolToVisibility}}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#FEF3C7"/>
                                    <Setter Property="BorderBrush" Value="#FCD34D"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding VitalSignsWarningLevel}" Value="2">
                                            <Setter Property="Background" Value="#FEE2E2"/>
                                            <Setter Property="BorderBrush" Value="#FCA5A5"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding VitalSignsWarning}" FontSize="{StaticResource FontSizeMicro}" TextWrapping="Wrap"
                                       Foreground="#92400E">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding VitalSignsWarningLevel}" Value="2">
                                                <Setter Property="Foreground" Value="#991B1B"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>

                        <!-- 诊断 -->
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="诊  断：" FontSize="{StaticResource FontSizeTiny}" VerticalAlignment="Top" Margin="0,4,0,0"/>
                            <TextBox Grid.Column="1" x:Name="DiagnosisTextBox"
                                     Text="{Binding DiagnosisText, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="{StaticResource FontSizeTiny}" BorderThickness="0,0,0,1" BorderBrush="{StaticResource BorderDefaultBrush}"
                                     Background="Transparent" Padding="0,2"
                                     MinHeight="24" VerticalContentAlignment="Center"
                                     GotFocus="DiagnosisTextBox_GotFocus"
                                     LostFocus="DiagnosisTextBox_LostFocus"
                                     ToolTip="点击输入时显示常见诊断快捷选择"/>
                        </Grid>

                        <!-- 诊断悬浮辅助工具栏 -->
                        <Popup x:Name="DiagnosisPopup" PlacementTarget="{Binding ElementName=DiagnosisTextBox}"
                               Placement="Bottom" HorizontalOffset="-50" VerticalOffset="2"
                               StaysOpen="True" AllowsTransparency="True" PopupAnimation="Fade">
                            <Border Background="White" BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="8"
                                    Padding="10,8" MaxWidth="420">
                                <StackPanel>
                                    <TextBlock Text="常见诊断（点击添加）" FontSize="{StaticResource FontSizeMicro}" FontWeight="SemiBold"
                                               Foreground="#2563EB" Margin="0,0,0,6"/>
                                    <ItemsControl ItemsSource="{Binding CommonDiagnoses}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Content="{Binding}"
                                                        Style="{StaticResource BtnTag}"
                                                        Click="DiagnosisTag_Click"
                                                        Margin="0,0,6,6"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Popup>

                        <!-- 医生签名 -->
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1" FontSize="{StaticResource FontSizeTiny}" VerticalAlignment="Center">
                                <Run Text="医师签名："/>
                                <Run Text="{Binding DoctorName, FallbackValue='_______________', Mode=OneWay}" FontWeight="SemiBold"/>
                            </TextBlock>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ── 模拟处方单 ── -->
                <Border BorderBrush="{StaticResource Gray400Brush}" BorderThickness="1" CornerRadius="2" Margin="0,0,0,10">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="White"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PrescriptionType}" Value="1">
                                    <Setter Property="Background" Value="#FFFDE7"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding PrescriptionType}" Value="2">
                                    <Setter Property="Background" Value="#F1F8E9"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Margin="16,12">
                        <!-- 处方标题 -->
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock Text="陈医生诊所" FontSize="{StaticResource FontSizeSmall}" FontWeight="Bold" VerticalAlignment="Center"/>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="循证辅助"
                                        Command="{Binding RunEvidenceBasedAnalysisCommand}"
                                        IsEnabled="{Binding CanRunEvidenceBased}"
                                        FontSize="{StaticResource FontSizeMicro}" Padding="6,2" Margin="0,0,8,0"
                                        Background="#ECFDF5" BorderBrush="#10B981" Foreground="#047857"
                                        Cursor="Hand" VerticalAlignment="Center"/>
                                <TextBlock VerticalAlignment="Center" FontSize="{StaticResource FontSizeMicro}">
                                    <Run Text="日期："/><Run Text="{Binding Source={x:Static sys:DateTime.Now}, StringFormat='yyyy-MM-dd', Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                        </DockPanel>
                        <TextBlock Text="处 方 笺" FontSize="{StaticResource FontSizeSubtitle}" FontWeight="Bold" HorizontalAlignment="Center"
                                   Margin="0,2,0,4" FontFamily="Microsoft YaHei"/>

                        <!-- 处方类型标签 -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,4">
                            <TextBlock FontSize="{StaticResource FontSizeMicro}" FontWeight="Bold" Padding="4,1" Margin="0,0,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="普通处方"/>
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PrescriptionType}" Value="0">
                                                <Setter Property="Text" Value="普通处方"/>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding PrescriptionType}" Value="1">
                                                <Setter Property="Text" Value="急 诊"/>
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Setter Property="Foreground" Value="#F57F17"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding PrescriptionType}" Value="2">
                                                <Setter Property="Text" Value="儿 科"/>
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Setter Property="Foreground" Value="#558B2F"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>

                        <Line X1="0" Y1="0" X2="1" Y2="0" Stretch="Fill" Stroke="#9CA3AF" StrokeThickness="1" Margin="0,0,0,6"/>

                        <!-- 患者信息 -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="50"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="姓名：" FontSize="{StaticResource FontSizeTiny}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding SelectedPatient.Name, FallbackValue='—'}" FontSize="{StaticResource FontSizeTiny}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="性别：" FontSize="{StaticResource FontSizeTiny}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            <TextBlock Grid.Column="3" Text="{Binding SelectedPatient.Gender, FallbackValue='—'}" FontSize="{StaticResource FontSizeTiny}" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- 主诉 + 诊断 -->
                        <TextBlock FontSize="{StaticResource FontSizeTiny}" Margin="0,0,0,2" TextWrapping="Wrap">
                            <Run Text="主诉："/><Run Text="{Binding ChiefComplaint, FallbackValue='—'}"/>
                        </TextBlock>
                        <TextBlock FontSize="{StaticResource FontSizeTiny}" Margin="0,0,0,6" TextWrapping="Wrap">
                            <Run Text="临床诊断："/><Run Text="{Binding DiagnosisText, FallbackValue='—'}"/>
                        </TextBlock>

                        <!-- Rp 标示 -->
                        <TextBlock Text="Rp" FontSize="{StaticResource FontSizeBody}" FontWeight="Bold" Margin="0,4,0,4"/>

                        <!-- 处方明细（内联编辑） -->
                        <DataGrid EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" x:Name="ItemsDataGrid"
                                  ItemsSource="{Binding PrescriptionItems}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#E5E7EB"
                                  BorderThickness="0"
                                  CellEditEnding="ItemsDataGrid_CellEditEnding">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="FontSize" Value="10"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Padding" Value="4,2"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderBrush" Value="#D1D5DB"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="FontSize" Value="11"/>
                                    <Setter Property="Padding" Value="2"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                </Style>
                            </DataGrid.CellStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="药品名称" Binding="{Binding DrugName}" Width="*" IsReadOnly="True"/>
                                <DataGridTextColumn Header="规格" Binding="{Binding Spec}" Width="70" IsReadOnly="True"/>
                                <DataGridTextColumn Header="剂量" Width="40">
                                    <DataGridTextColumn.Binding>
                                        <Binding Path="Dose" UpdateSourceTrigger="LostFocus" Converter="{StaticResource DecimalInput}"/>
                                    </DataGridTextColumn.Binding>
                                </DataGridTextColumn>
                                <DataGridComboBoxColumn Header="单位" Width="40"
                                                         SelectedItemBinding="{Binding DoseUnit, UpdateSourceTrigger=PropertyChanged}"
                                                         ItemsSource="{StaticResource DoseUnits}"/>
                                <DataGridComboBoxColumn Header="频次" Width="65"
                                                         SelectedItemBinding="{Binding Frequency, UpdateSourceTrigger=PropertyChanged}"
                                                         ItemsSource="{StaticResource Frequencies}"/>
                                <DataGridComboBoxColumn Header="用法" Width="55"
                                                         SelectedItemBinding="{Binding Route, UpdateSourceTrigger=PropertyChanged}"
                                                         ItemsSource="{StaticResource Routes}"/>
                                <DataGridTextColumn Header="天" Binding="{Binding DurationDays, UpdateSourceTrigger=PropertyChanged}" Width="35"/>
                                <DataGridTextColumn Header="数量" Width="45">
                                    <DataGridTextColumn.Binding>
                                        <Binding Path="Qty" UpdateSourceTrigger="LostFocus" Converter="{StaticResource DecimalInput}"/>
                                    </DataGridTextColumn.Binding>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="单价" Binding="{Binding UnitPricePerUnit, StringFormat=F2}" Width="45" IsReadOnly="True"/>
                                <DataGridTextColumn Header="金额" Binding="{Binding Subtotal, StringFormat=F2}" Width="50" IsReadOnly="True"/>
                                <DataGridTemplateColumn Header="" Width="40">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="✕"
                                                    FontSize="{StaticResource FontSizeMicro}" Padding="4,1" Margin="0"
                                                    Background="#FEF2F2" BorderBrush="#FCA5A5" Foreground="{StaticResource ErrorBrush}"
                                                    Cursor="Hand"
                                                    Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding DataContext.IsDraft, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource BoolToVisibility}}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- 处方完毕标记 -->
                        <TextBlock Text="/" FontSize="{StaticResource FontSizeBody}" HorizontalAlignment="Right" Margin="0,2,0,4"/>

                        <!-- 费用明细 -->
                        <Grid Margin="0,4,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="诊疗费：¥" FontSize="{StaticResource FontSizeTiny}" VerticalAlignment="Center"/>
                                <TextBox Text="{Binding ConsultationFee, UpdateSourceTrigger=PropertyChanged}"
                                         Width="50" FontSize="{StaticResource FontSizeTiny}" Padding="2" Margin="2,0"
                                         AutomationProperties.Name="诊疗费"
                                         VerticalContentAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Grid.Column="3" FontSize="{StaticResource FontSizeCaption}" FontWeight="Bold" VerticalAlignment="Center">
                                <Run Text="合计：¥"/>
                                <Run Text="{Binding TotalAmount, StringFormat=F2, Mode=OneWay}"/>
                            </TextBlock>
                        </Grid>

                        <!-- 签名区 -->
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1" FontSize="{StaticResource FontSizeTiny}" VerticalAlignment="Center">
                                <Run Text="医师签名："/>
                                <Run Text="{Binding DoctorName, FallbackValue='_________', Mode=OneWay}" FontWeight="SemiBold"/>
                            </TextBlock>
                            <TextBlock Grid.Column="3" Text="审核/调配：_________" FontSize="{StaticResource FontSizeTiny}" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ── AI药师审核意见（分级分色，仅参考不阻断） ── -->
                <Border Margin="0,0,0,8" Padding="10,6" CornerRadius="4"
                        Visibility="{Binding HasAiAdvice, Converter={StaticResource BoolToVisibility}}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#F0FDF4"/>
                            <Setter Property="BorderBrush" Value="#A7F3D0"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding AiAdviceLevel}" Value="1">
                                    <Setter Property="Background" Value="#FFFBEB"/>
                                    <Setter Property="BorderBrush" Value="#FDE68A"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding AiAdviceLevel}" Value="2">
                                    <Setter Property="Background" Value="#FFF7ED"/>
                                    <Setter Property="BorderBrush" Value="#FDBA74"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding AiAdviceLevel}" Value="3">
                                    <Setter Property="Background" Value="#FEF2F2"/>
                                    <Setter Property="BorderBrush" Value="#FCA5A5"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock FontSize="{StaticResource FontSizeTiny}" FontWeight="SemiBold" Margin="0,0,0,2">
                            <Run Text="📋 AI药师审核（仅供参考，最终由执业医生决定）"/>
                        </TextBlock>
                        <TextBlock Text="{Binding AiPharmacistAdvice}" FontSize="{StaticResource FontSizeTiny}" TextWrapping="Wrap"
                                   Foreground="{StaticResource Gray700Brush}"/>
                    </StackPanel>
                </Border>

                <!-- ── 循证医学辅助决策面板 ── -->
                <Border Margin="0,0,0,8" Padding="10,8" CornerRadius="6"
                        Background="#F0F9FF" BorderBrush="#7DD3FC" BorderThickness="1"
                        Visibility="{Binding ShowEvidenceBasedPanel, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock FontSize="{StaticResource FontSizeTiny}" FontWeight="SemiBold" Foreground="#0369A1"
                                       Text="🔬 循证医学辅助决策（仅供参考，最终由执业医生决定）"/>
                            <Button DockPanel.Dock="Right" Content="✕" FontSize="9" Padding="4,0"
                                    Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextMutedBrush}"
                                    Cursor="Hand" Click="CloseEvidencePanel_Click"/>
                        </DockPanel>

                        <!-- 加载中 -->
                        <TextBlock Text="正在分析..." FontSize="{StaticResource FontSizeTiny}" Foreground="{StaticResource TextMutedBrush}"
                                   Visibility="{Binding IsEvidenceBasedLoading, Converter={StaticResource BoolToVisibility}}"/>

                        <!-- 分析结果 -->
                        <StackPanel Visibility="{Binding IsEvidenceBasedLoading, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                            <!-- 证据级别 -->
                            <TextBlock FontSize="{StaticResource FontSizeMicro}" Foreground="#0369A1" Margin="0,0,0,4">
                                <Run Text="证据级别："/><Run Text="{Binding EvidenceBasedAdvice.EvidenceLevel, FallbackValue='—'}"/>
                            </TextBlock>

                            <!-- 鉴别诊断 -->
                            <TextBlock FontSize="{StaticResource FontSizeMicro}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,1">鉴别诊断</TextBlock>
                            <TextBlock Text="{Binding EvidenceBasedAdvice.DifferentialDiagnoses, FallbackValue='—'}"
                                       FontSize="{StaticResource FontSizeMicro}" TextWrapping="Wrap" Foreground="{StaticResource Gray700Brush}" Margin="0,0,0,4"/>

                            <!-- 建议检查 -->
                            <TextBlock FontSize="{StaticResource FontSizeMicro}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,1">建议检查</TextBlock>
                            <TextBlock Text="{Binding EvidenceBasedAdvice.SuggestedExams, FallbackValue='—'}"
                                       FontSize="{StaticResource FontSizeMicro}" TextWrapping="Wrap" Foreground="{StaticResource Gray700Brush}" Margin="0,0,0,4"/>

                            <!-- 治疗方案 -->
                            <TextBlock FontSize="{StaticResource FontSizeMicro}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,1">治疗方案</TextBlock>
                            <TextBlock Text="{Binding EvidenceBasedAdvice.TreatmentOptions, FallbackValue='—'}"
                                       FontSize="{StaticResource FontSizeMicro}" TextWrapping="Wrap" Foreground="{StaticResource Gray700Brush}" Margin="0,0,0,4"/>

                            <!-- 用药参考 -->
                            <TextBlock FontSize="{StaticResource FontSizeMicro}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,1">用药参考</TextBlock>
                            <TextBlock Text="{Binding EvidenceBasedAdvice.MedicationReference, FallbackValue='—'}"
                                       FontSize="{StaticResource FontSizeMicro}" TextWrapping="Wrap" Foreground="{StaticResource Gray700Brush}" Margin="0,0,0,4"/>

                            <!-- 风险提示 -->
                            <Border Background="#FEF2F2" CornerRadius="4" Padding="6,4" Margin="0,4,0,0">
                                <TextBlock FontSize="{StaticResource FontSizeMicro}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,1">
                                    <Run Text="⚠ 风险提示："/>
                                    <Run Text="{Binding EvidenceBasedAdvice.RiskWarnings, FallbackValue='无'}" Foreground="#991B1B"/>
                                </TextBlock>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ── 状态消息 ── -->
                <StackPanel Margin="0,4,0,0">
                    <TextBlock Text="{Binding ErrorMessage}"
                               Style="{StaticResource TextError}"
                               Visibility="{Binding ErrorMessage, Converter={StaticResource NullToCollapsed}}"/>
                    <TextBlock Text="{Binding StatusMessage}"
                               Style="{StaticResource TextSuccess}"
                               Visibility="{Binding StatusMessage, Converter={StaticResource NullToCollapsed}}"/>
                </StackPanel>

                <!-- ── 操作按钮 ── -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                    <Button Style="{StaticResource BtnOutline}"
                            Command="{Binding NewPrescriptionCommand}"
                            Margin="0,0,8,0" Content="新建处方"/>
                    <Button Style="{StaticResource BtnOutline}"
                            Command="{Binding SavePrescriptionCommand}"
                            Margin="0,0,8,0" Content="仅保存"/>
                    <Button Style="{StaticResource BtnPrimaryLg}"
                            Command="{Binding SaveAndReviewCommand}"
                            Margin="0,0,8,0" Content="保存并打印"/>
                    <Button Style="{StaticResource BtnSuccess}"
                            Command="{Binding GoToBillingCommand}"
                            Visibility="{Binding CanGoToBilling, Converter={StaticResource BoolToVisibility}}"
                            Content="前往收费"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
