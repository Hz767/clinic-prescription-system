<Window x:Class="Clinic.Presentation.Views.DrugPickerSecondaryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Clinic.Presentation.ViewModels"
        mc:Ignorable="d"
        Title="药品选择（副屏）"
        Width="560" Height="760" MinWidth="480" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="#F7F7F9"
        d:DataContext="{d:DesignInstance Type=vm:PrescriptionViewModel}">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <TextBlock Grid.Row="0" Text="药品选择（副屏选药 · 主屏专注录入）"
                   FontWeight="SemiBold" FontSize="{StaticResource FontSizeBody}"
                   Foreground="{StaticResource Gray900Brush}" Margin="0,0,0,8"/>

        <!-- 搜索 -->
        <TextBox Grid.Row="1" Height="30" Padding="8,0"
                 Text="{Binding DrugFilter, UpdateSourceTrigger=PropertyChanged}"
                 FontSize="{StaticResource FontSizeBody}"
                 ToolTip="输入药品名称/规格关键词过滤"/>
        <!-- 分类筛选 -->
        <ComboBox Grid.Row="2" Height="28" Margin="0,6,0,8" VerticalContentAlignment="Center"
                  SelectedIndex="{Binding DrugCategoryFilter, Mode=TwoWay}">
            <ComboBoxItem Content="全部药品"/>
            <ComboBoxItem Content="仅抗菌药"/>
            <ComboBoxItem Content="特殊管理药品"/>
            <ComboBoxItem Content="低库存预警"/>
        </ComboBox>

        <!-- 药品列表：双击快速添加 -->
        <ListBox Grid.Row="3" ItemsSource="{Binding Drugs}"
                 SelectedItem="{Binding SelectedDrug, Mode=TwoWay}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 MouseDoubleClick="DrugsList_MouseDoubleClick"
                 BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Padding="8,5" Background="Transparent">
                        <StackPanel>
                            <DockPanel>
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                    <TextBlock Text="{Binding RetailPriceRef, StringFormat=¥{0:F2}}" FontSize="{StaticResource FontSizeMicro}"
                                               Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold"/>
                                </StackPanel>
                                <TextBlock Text="{Binding GenericNameCn}" FontSize="{StaticResource FontSizeCaption}"
                                           Foreground="{StaticResource Gray800Brush}"/>
                            </DockPanel>
                            <TextBlock Text="{Binding Spec}" FontSize="{StaticResource FontSizeMicro}"
                                       Foreground="{StaticResource TextMutedBrush}" Margin="0,1,0,0"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- 已选明细概览 -->
        <Border Grid.Row="4" Background="White" BorderBrush="{StaticResource BorderDefaultBrush}"
                BorderThickness="1" CornerRadius="5" Margin="0,10,0,0" Padding="10">
            <StackPanel>
                <TextBlock Text="当前药品明细" FontSize="{StaticResource FontSizeSmall}" FontWeight="SemiBold"
                           Foreground="{StaticResource Gray900Brush}" Margin="0,0,0,6"/>
                <ItemsControl ItemsSource="{Binding PrescriptionItems}" MaxHeight="150">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,2,0,2">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                    <TextBlock Text="{Binding Qty, StringFormat=×{0:F0}}" FontSize="{StaticResource FontSizeMicro}"
                                               Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding Subtotal, StringFormat=¥{0:F2}}" FontSize="{StaticResource FontSizeMicro}"
                                               Foreground="{StaticResource Gray700Brush}" Margin="6,0,0,0"/>
                                </StackPanel>
                                <TextBlock Text="{Binding DrugName}" FontSize="{StaticResource FontSizeMicro}"
                                           Foreground="{StaticResource Gray700Brush}" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <DockPanel Margin="0,6,0,0">
                    <TextBlock Text="总金额" FontSize="{StaticResource FontSizeCaption}" Foreground="{StaticResource Gray600Brush}"
                               DockPanel.Dock="Left" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding TotalAmount, StringFormat=¥{0:F2}}" FontSize="{StaticResource FontSizeBody}"
                               FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Center"/>
                </DockPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>