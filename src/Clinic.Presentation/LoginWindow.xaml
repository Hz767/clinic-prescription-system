<Window x:Class="Clinic.Presentation.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Clinic.Presentation.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:LoginViewModel}"
        Title="登录 — 陈医生诊所处方管理系统"
        Width="420" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        SizeToContent="Height">
    <Window.Resources>
        <conv:NullToCollapsedConverter x:Key="NullToCollapsedConverter"
                                        xmlns:conv="clr-namespace:Clinic.Presentation.Converters"/>
    </Window.Resources>

    <Border CornerRadius="0">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0F766E" Offset="0"/>
                <GradientStop Color="#0D9488" Offset="0.5"/>
                <GradientStop Color="#14B8A6" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>

        <Grid Margin="40,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Logo + Title -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center">
                <Border Width="56" Height="56" CornerRadius="14"
                        Background="#26FFFFFF"
                        HorizontalAlignment="Center" Margin="0,0,0,12">
                    <Path Data="{StaticResource IconStethoscope}"
                          Width="30" Height="30" Stretch="Uniform"
                          Stroke="White" StrokeThickness="2"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="陈医生诊所处方管理系统"
                           FontSize="18" FontWeight="SemiBold"
                           Foreground="White" HorizontalAlignment="Center"/>
                <TextBlock Text="Dr. Chen's Clinic"
                           FontSize="{StaticResource FontSizeTiny}" Foreground="#A7F3D0"
                           HorizontalAlignment="Center" Margin="0,2,0,0"/>
            </StackPanel>

            <!-- Login Card -->
            <Border Grid.Row="2" Grid.RowSpan="9"
                    Background="White"
                    CornerRadius="12"
                    Padding="24,20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="6"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="6"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="1"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Username -->
                    <TextBlock Grid.Row="0" Text="用户名"
                               Style="{StaticResource TextLabel}"/>
                    <TextBox Grid.Row="2"
                             Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="用户名"/>

                    <!-- Password -->
                    <TextBlock Grid.Row="4" Text="密码"
                               Style="{StaticResource TextLabel}"/>
                    <PasswordBox Grid.Row="6"
                                 x:Name="PasswordBox"
                                 AutomationProperties.Name="密码"
                                 PasswordChanged="PasswordBox_PasswordChanged"/>

                    <!-- AI 辅助选项 -->
                    <CheckBox Grid.Row="8"
                              Content="启用 AI 辅助（加载本地大模型，需 ≥6GB 内存）"
                              IsChecked="{Binding EnableAiAssistant}"
                              FontSize="{StaticResource FontSizeTiny}"
                              Foreground="{StaticResource TextSecondaryBrush}"
                              Margin="0,4,0,0"/>

                    <!-- 系统自检状态 -->
                    <TextBlock Grid.Row="9"
                               Text="{Binding HealthCheckMessage}"
                               FontSize="{StaticResource FontSizeMicro}"
                               Foreground="{Binding HealthCheckColor}"
                               TextWrapping="Wrap"
                               Margin="0,2,0,0"
                               Visibility="{Binding HealthCheckMessage, Converter={StaticResource NullToCollapsedConverter}}"/>

                    <!-- Error Message -->
                    <Border Grid.Row="11"
                            Background="{StaticResource ErrorBgBrush}"
                            CornerRadius="6" Padding="12,8"
                            Visibility="{Binding ErrorMessage, Converter={StaticResource NullToCollapsedConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconAlertCircle}"
                                  Width="16" Height="16" Stretch="Uniform"
                                  Stroke="{StaticResource ErrorBrush}" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding ErrorMessage}"
                                       Style="{StaticResource TextError}"/>
                        </StackPanel>
                    </Border>

                    <!-- Login Button -->
                    <Button Grid.Row="13"
                            Content="登 录"
                            Style="{StaticResource BtnPrimaryLg}"
                            Command="{Binding LoginCommand}"
                            IsDefault="True"/>

                    <!-- 分隔线 -->
                    <Border Grid.Row="15" Height="1" Background="{StaticResource Gray200Brush}"/>

                    <!-- 注册链接 -->
                    <TextBlock Grid.Row="17" HorizontalAlignment="Center">
                        <Hyperlink Click="RegisterLink_Click" Foreground="{StaticResource PrimaryDarkBrush}" FontSize="{StaticResource FontSizeTiny}"
                                   TextDecorations="None">
                            <Run Text="没有账号？点击注册医生"/>
                        </Hyperlink>
                    </TextBlock>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
