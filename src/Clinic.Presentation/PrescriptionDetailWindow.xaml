<Window x:Class="Clinic.Presentation.PrescriptionDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="处方详情"
        Height="600" Width="800"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <Window.Resources>
        <conv:NullToCollapsedConverter x:Key="NullToCollapsedConverter"
                                        xmlns:conv="clr-namespace:Clinic.Presentation.Converters"/>
    </Window.Resources>
    <Grid Background="{StaticResource SurfaceDarkBrush}" Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 处方抬头 -->
        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
            <StackPanel>
                <TextBlock Text="陈医生诊所" FontSize="{StaticResource FontSizeSubtitle}" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock Text="处 方 笺" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock FontSize="{StaticResource FontSizeTiny}" Foreground="{StaticResource TextMutedBrush}">
                            <Run Text="处方编号："/><Run Text="{Binding PrescriptionNo}" FontWeight="SemiBold"/>
                        </TextBlock>
                        <TextBlock FontSize="{StaticResource FontSizeTiny}" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0">
                            <Run Text="患者姓名："/><Run Text="{Binding PatientName}" FontWeight="SemiBold"/>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock FontSize="{StaticResource FontSizeTiny}" Foreground="{StaticResource TextMutedBrush}">
                            <Run Text="开具医生："/><Run Text="{Binding DoctorName}" FontWeight="SemiBold"/>
                        </TextBlock>
                        <TextBlock FontSize="{StaticResource FontSizeTiny}" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0">
                            <Run Text="开具时间："/><Run Text="{Binding CreatedAt}" FontWeight="SemiBold"/>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock FontSize="{StaticResource FontSizeTiny}" Foreground="{StaticResource TextMutedBrush}">
                            <Run Text="处方类型："/><Run Text="{Binding PrescriptionTypeText}" FontWeight="SemiBold"/>
                        </TextBlock>
                        <TextBlock FontSize="{StaticResource FontSizeTiny}" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0">
                            <Run Text="状态："/><Run Text="{Binding StatusText}" FontWeight="SemiBold"/>
                        </TextBlock>
                    </StackPanel>
                </Grid>
                <TextBlock FontSize="{StaticResource FontSizeCaption}" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,8,0,0" TextWrapping="Wrap">
                    <Run Text="临床诊断：" FontWeight="SemiBold"/><Run Text="{Binding DiagnosisText}"/>
                </TextBlock>
                <TextBlock FontSize="{StaticResource FontSizeTiny}" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap"
                           Visibility="{Binding ChiefComplaint, Converter={StaticResource NullToCollapsedConverter}}">
                    <Run Text="主诉："/><Run Text="{Binding ChiefComplaint}"/>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- 处方明细 -->
        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
            <TextBlock Text="处方明细" FontSize="{StaticResource FontSizeSmall}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
        </Border>

        <DataGrid EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" Grid.Row="4"
                  ItemsSource="{Binding Items}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  RowHeight="32">
            <DataGrid.Columns>
                <DataGridTextColumn Header="药品名称" Binding="{Binding DrugName}" Width="*"/>
                <DataGridTextColumn Header="规格" Binding="{Binding Spec}" Width="100"/>
                <DataGridTextColumn Header="剂量" Binding="{Binding DoseText}" Width="80"/>
                <DataGridTextColumn Header="频次" Binding="{Binding Frequency}" Width="80"/>
                <DataGridTextColumn Header="用法" Binding="{Binding Route}" Width="60"/>
                <DataGridTextColumn Header="天数" Binding="{Binding DurationDays}" Width="50"/>
                <DataGridTextColumn Header="数量" Binding="{Binding QtyText}" Width="60"/>
                <DataGridTextColumn Header="单价" Binding="{Binding UnitPrice, StringFormat=F2}" Width="70"/>
                <DataGridTextColumn Header="金额" Binding="{Binding Subtotal, StringFormat=F2}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 合计 -->
        <Border Grid.Row="6" Background="White" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="关闭" Width="100"
                        Click="CloseButton_Click"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontSize="{StaticResource FontSizeBody}" Foreground="{StaticResource TextPrimaryBrush}">
                        <Run Text="合计金额：¥"/><Run Text="{Binding TotalAmount, StringFormat=F2}" FontWeight="Bold" FontSize="{StaticResource FontSizeSubtitle}" Foreground="{StaticResource ErrorBrush}"/>
                    </TextBlock>
                    <TextBlock FontSize="{StaticResource FontSizeTiny}" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0">
                        <Run Text="共 "/><Run Text="{Binding ItemCount}"/><Run Text=" 种药品"/>
                    </TextBlock>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
