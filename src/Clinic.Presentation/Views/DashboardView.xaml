<UserControl x:Class="Clinic.Presentation.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Clinic.Presentation.ViewModels"
             xmlns:views="clr-namespace:Clinic.Presentation.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:DashboardViewModel}"
             Background="{StaticResource SurfaceDarkBrush}">
    <UserControl.Resources>
        <conv:NullToCollapsedConverter x:Key="NullToCollapsed"
                                        xmlns:conv="clr-namespace:Clinic.Presentation.Converters"/>
        <conv:InverseBooleanConverter x:Key="InverseBool"
                                       xmlns:conv="clr-namespace:Clinic.Presentation.Converters"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">

            <!-- ════ 顶部：欢迎 + 日期 + 刷新 ════ -->
            <DockPanel Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="工作台" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Gray900Brush}"/>
                    <TextBlock Text="{Binding Source={x:Static sys:DateTime.Now}, StringFormat='yyyy年MM月dd日 dddd'}"
                               FontSize="{StaticResource FontSizeCaption}" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"
                               xmlns:sys="clr-namespace:System;assembly=mscorlib"/>
                </StackPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource BtnOutline}"
                        Command="{Binding LoadDataCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconRefresh}"
                              Width="14" Height="14" Stretch="Uniform"
                              Stroke="{StaticResource Gray600Brush}" StrokeThickness="2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="刷新" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </DockPanel>

            <!-- ════ KPI 卡片行 ════ -->
            <UniformGrid Columns="6" Rows="1" Margin="0,0,0,16">

                <!-- 今日处方 -->
                <Border Style="{StaticResource StatCardBorder}" Background="White" Margin="0,0,8,0">
                    <StackPanel Margin="14,12">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconClipboardList}"
                                  Width="16" Height="16" Stretch="Uniform"
                                  Stroke="{StaticResource PrimaryBrush}" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            <TextBlock Text="今日处方" FontSize="{StaticResource FontSizeTiny}" Foreground="{StaticResource TextMutedBrush}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding TodayPrescriptionCount}"
                                   FontSize="28" FontWeight="Bold" Foreground="{StaticResource Gray900Brush}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 今日收入 -->
                <Border Style="{StaticResource StatCardBorder}" Background="White" Margin="0,0,8,0">
                    <StackPanel Margin="14,12">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconCash}"
                                  Width="16" Height="16" Stretch="Uniform"
                                  Fill="{StaticResource SuccessBrush}"/>
                            <TextBlock Text="今日收入" FontSize="{StaticResource FontSizeTiny}" Foreground="{StaticResource TextMutedBrush}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="¥" FontSize="{StaticResource FontSizeBody}" Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding TodayRevenue, StringFormat=F2}"
                                       FontSize="24" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 待审核 -->
                <Border Style="{StaticResource StatCardBorder}" Background="White" Margin="0,0,8,0">
                    <StackPanel Margin="14,12">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconShield}"
                                  Width="16" Height="16" Stretch="Uniform"
                                  Stroke="#F59E0B" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            <TextBlock Text="待审核" FontSize="{StaticResource FontSizeTiny}" Foreground="{StaticResource TextMutedBrush}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding PendingReviewCount}"
                                   FontSize="28" FontWeight="Bold" Foreground="#F59E0B" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 待收费 -->
                <Border Style="{StaticResource StatCardBorder}" Background="White" Margin="0,0,8,0">
                    <StackPanel Margin="14,12">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconReceipt}"
                                  Width="16" Height="16" Stretch="Uniform"
                                  Stroke="#8B5CF6" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            <TextBlock Text="待收费" FontSize="{StaticResource FontSizeTiny}" Foreground="{StaticResource TextMutedBrush}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding PendingBillingCount}"
                                   FontSize="28" FontWeight="Bold" Foreground="#8B5CF6" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 待发药 -->
                <Border Style="{StaticResource StatCardBorder}" Background="White" Margin="0,0,8,0">
                    <StackPanel Margin="14,12">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconPackage}"
                                  Width="16" Height="16" Stretch="Uniform"
                                  Stroke="#0EA5E9" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            <TextBlock Text="待发药" FontSize="{StaticResource FontSizeTiny}" Foreground="{StaticResource TextMutedBrush}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding PendingDispenseCount}"
                                   FontSize="28" FontWeight="Bold" Foreground="#0EA5E9" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 库存预警 -->
                <Border Style="{StaticResource StatCardBorder}" Background="White">
                    <StackPanel Margin="14,12">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconAlertTriangle}"
                                  Width="16" Height="16" Stretch="Uniform"
                                  Stroke="#EF4444" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            <TextBlock Text="库存预警" FontSize="{StaticResource FontSizeTiny}" Foreground="{StaticResource TextMutedBrush}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="{Binding LowStockCount}"
                                       FontSize="28" FontWeight="Bold" Foreground="#EF4444"/>
                            <TextBlock Text="低库存" FontSize="{StaticResource FontSizeTiny}" Foreground="{StaticResource TextDisabledBrush}" Margin="4,0,0,0" VerticalAlignment="Bottom"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

            </UniformGrid>

            <!-- ════ 快捷操作 ════ -->
            <UniformGrid Columns="4" Rows="1" Margin="0,0,0,16">
                <Button Style="{StaticResource BtnPrimaryLg}" Command="{Binding NavigateToPrescriptionCommand}" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconPrescription}" Width="18" Height="18" Stretch="Uniform"
                              Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="新建处方" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource BtnOutline}" Command="{Binding NavigateToPatientCommand}" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconUserPlus}" Width="18" Height="18" Stretch="Uniform"
                              Stroke="{StaticResource Gray600Brush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="患者建档" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource BtnOutline}" Command="{Binding NavigateToBillingCommand}" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconCash}" Width="18" Height="18" Stretch="Uniform"
                              Fill="{StaticResource Gray600Brush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="收费发药" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource BtnOutline}" Command="{Binding NavigateToInventoryCommand}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconDatabaseImport}" Width="18" Height="18" Stretch="Uniform"
                              Stroke="{StaticResource Gray600Brush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="药品入库" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </UniformGrid>

            <!-- ════ 待办队列 ════ -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 待审核 -->
                <Border Grid.Column="0" Style="{StaticResource CardBorder}" Background="White">
                    <StackPanel Margin="12">
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="待审核处方" FontSize="{StaticResource FontSizeSmall}" FontWeight="SemiBold" Foreground="{StaticResource Gray900Brush}" VerticalAlignment="Center"/>
                            <Border DockPanel.Dock="Right" Background="{StaticResource WarningBgBrush}" CornerRadius="10" Padding="6,1">
                                <TextBlock Text="{Binding PendingReviewCount}" FontSize="{StaticResource FontSizeTiny}" FontWeight="Bold" Foreground="#D97706" HorizontalAlignment="Center"/>
                            </Border>
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding PendingReviewList}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#FFFBEB" CornerRadius="4" Padding="8,6" Margin="0,0,0,6">
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock Text="{Binding PatientName}" FontSize="{StaticResource FontSizeCaption}" FontWeight="SemiBold" Foreground="#92400E"/>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding NoYearSeq}" FontSize="{StaticResource FontSizeMicro}" Foreground="#A8A29E"/>
                                            </DockPanel>
                                            <TextBlock Text="{Binding DiagnosisText}" FontSize="{StaticResource FontSizeMicro}" Foreground="#78716C" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                            <!-- 进度条：开方完成（1/4）→ 下一步：药师审核 -->
                                            <Grid Height="4" Margin="0,6,0,5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Background="#F59E0B" CornerRadius="2,0,0,2"/>
                                                <Border Grid.Column="1" Background="#FFE4A3" Margin="2,0,0,0"/>
                                                <Border Grid.Column="2" Background="#FFE4A3" Margin="2,0,0,0"/>
                                                <Border Grid.Column="3" Background="#FFE4A3" Margin="2,0,0,0" CornerRadius="0,2,2,0"/>
                                            </Grid>
                                            <DockPanel>
                                                <TextBlock Text="下一步：药师审核" FontSize="{StaticResource FontSizeMicro}" Foreground="#D97706" VerticalAlignment="Center"/>
                                                <Button DockPanel.Dock="Right" Content="去审核" Style="{StaticResource BtnPrimarySm}"
                                                        Height="22" Padding="10,0" FontSize="{StaticResource FontSizeMicro}"
                                                        Command="{Binding DataContext.HandlePendingPrescriptionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"/>
                                            </DockPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="暂无待审核处方" FontSize="{StaticResource FontSizeTiny}" Foreground="{StaticResource TextDisabledBrush}" HorizontalAlignment="Center" Margin="0,8,0,0"
                                   Visibility="{Binding PendingReviewCount, Converter={StaticResource NullToCollapsed}}"/>
                    </StackPanel>
                </Border>

                <!-- 待收费 -->
                <Border Grid.Column="2" Style="{StaticResource CardBorder}" Background="White">
                    <StackPanel Margin="12">
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="待收费处方" FontSize="{StaticResource FontSizeSmall}" FontWeight="SemiBold" Foreground="{StaticResource Gray900Brush}" VerticalAlignment="Center"/>
                            <Border DockPanel.Dock="Right" Background="#EDE9FE" CornerRadius="10" Padding="6,1">
                                <TextBlock Text="{Binding PendingBillingCount}" FontSize="{StaticResource FontSizeTiny}" FontWeight="Bold" Foreground="#7C3AED" HorizontalAlignment="Center"/>
                            </Border>
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding PendingBillingList}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#F5F3FF" CornerRadius="4" Padding="8,6" Margin="0,0,0,6">
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock Text="{Binding PatientName}" FontSize="{StaticResource FontSizeCaption}" FontWeight="SemiBold" Foreground="#5B21B6"/>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding NoYearSeq}" FontSize="{StaticResource FontSizeMicro}" Foreground="#A78BFA"/>
                                            </DockPanel>
                                            <DockPanel Margin="0,2,0,0">
                                                <TextBlock Text="{Binding DiagnosisText}" FontSize="{StaticResource FontSizeMicro}" Foreground="#78716C" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding TotalAmount, StringFormat=¥{0:F2}}" FontSize="{StaticResource FontSizeTiny}" FontWeight="Bold" Foreground="#7C3AED"/>
                                            </DockPanel>
                                            <!-- 进度条：开方+审核完成（2/4）→ 下一步：收费 -->
                                            <Grid Height="4" Margin="0,6,0,5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Background="#8B5CF6" CornerRadius="2,0,0,2"/>
                                                <Border Grid.Column="1" Background="#8B5CF6" Margin="2,0,0,0"/>
                                                <Border Grid.Column="2" Background="#EDE9FE" Margin="2,0,0,0"/>
                                                <Border Grid.Column="3" Background="#EDE9FE" Margin="2,0,0,0" CornerRadius="0,2,2,0"/>
                                            </Grid>
                                            <DockPanel>
                                                <TextBlock Text="下一步：收费结算" FontSize="{StaticResource FontSizeMicro}" Foreground="#6D28D9" VerticalAlignment="Center"/>
                                                <Button DockPanel.Dock="Right" Content="去收费" Style="{StaticResource BtnPrimarySm}"
                                                        Height="22" Padding="10,0" FontSize="{StaticResource FontSizeMicro}"
                                                        Command="{Binding DataContext.HandlePendingPrescriptionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"/>
                                            </DockPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="暂无待收费处方" FontSize="{StaticResource FontSizeTiny}" Foreground="{StaticResource TextDisabledBrush}" HorizontalAlignment="Center" Margin="0,8,0,0"
                                   Visibility="{Binding PendingBillingCount, Converter={StaticResource NullToCollapsed}}"/>
                    </StackPanel>
                </Border>

                <!-- 待发药 -->
                <Border Grid.Column="4" Style="{StaticResource CardBorder}" Background="White">
                    <StackPanel Margin="12">
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="待发药处方" FontSize="{StaticResource FontSizeSmall}" FontWeight="SemiBold" Foreground="{StaticResource Gray900Brush}" VerticalAlignment="Center"/>
                            <Border DockPanel.Dock="Right" Background="#E0F2FE" CornerRadius="10" Padding="6,1">
                                <TextBlock Text="{Binding PendingDispenseCount}" FontSize="{StaticResource FontSizeTiny}" FontWeight="Bold" Foreground="#0284C7" HorizontalAlignment="Center"/>
                            </Border>
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding PendingDispenseList}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#F0F9FF" CornerRadius="4" Padding="8,6" Margin="0,0,0,6">
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock Text="{Binding PatientName}" FontSize="{StaticResource FontSizeCaption}" FontWeight="SemiBold" Foreground="#075985"/>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding NoYearSeq}" FontSize="{StaticResource FontSizeMicro}" Foreground="#7DD3FC"/>
                                            </DockPanel>
                                            <TextBlock Text="{Binding DiagnosisText}" FontSize="{StaticResource FontSizeMicro}" Foreground="#78716C" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                            <!-- 进度条：开方+审核+收费完成（3/4）→ 下一步：确认发药 -->
                                            <Grid Height="4" Margin="0,6,0,5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Background="#0EA5E9" CornerRadius="2,0,0,2"/>
                                                <Border Grid.Column="1" Background="#0EA5E9" Margin="2,0,0,0"/>
                                                <Border Grid.Column="2" Background="#0EA5E9" Margin="2,0,0,0"/>
                                                <Border Grid.Column="3" Background="#E0F2FE" Margin="2,0,0,0" CornerRadius="0,2,2,0"/>
                                            </Grid>
                                            <DockPanel>
                                                <TextBlock Text="下一步：确认发药" FontSize="{StaticResource FontSizeMicro}" Foreground="#0284C7" VerticalAlignment="Center"/>
                                                <Button DockPanel.Dock="Right" Content="去发药" Style="{StaticResource BtnPrimarySm}"
                                                        Height="22" Padding="10,0" FontSize="{StaticResource FontSizeMicro}"
                                                        Command="{Binding DataContext.HandlePendingPrescriptionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"/>
                                            </DockPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="暂无待发药处方" FontSize="{StaticResource FontSizeTiny}" Foreground="{StaticResource TextDisabledBrush}" HorizontalAlignment="Center" Margin="0,8,0,0"
                                   Visibility="{Binding PendingDispenseCount, Converter={StaticResource NullToCollapsed}}"/>
                    </StackPanel>
                </Border>

            </Grid>

            <!-- ════ 近7日趋势 ════ -->
            <Border Style="{StaticResource CardBorder}" Background="White" Margin="0,0,0,16">
                <StackPanel Margin="12">
                    <DockPanel Margin="0,0,0,10">
                        <TextBlock Text="近7日趋势" FontSize="{StaticResource FontSizeSmall}" FontWeight="SemiBold" Foreground="{StaticResource Gray900Brush}" VerticalAlignment="Center"/>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Border Background="{StaticResource PrimaryBgBrush}" CornerRadius="4" Padding="8,2" Margin="0,0,8,0">
                                <TextBlock FontSize="{StaticResource FontSizeTiny}">
                                    <Run Text="处方总量：" Foreground="{StaticResource TextMutedBrush}"/>
                                    <Run Text="{Binding WeekTotalPrescriptions}" Foreground="{StaticResource PrimaryDarkBrush}" FontWeight="Bold"/>
                                </TextBlock>
                            </Border>
                            <Border Background="#F0FDF4" CornerRadius="4" Padding="8,2">
                                <TextBlock FontSize="{StaticResource FontSizeTiny}">
                                    <Run Text="总收入：¥" Foreground="{StaticResource TextMutedBrush}"/>
                                    <Run Text="{Binding WeekTotalRevenue, StringFormat=F2}" Foreground="#16A34A" FontWeight="Bold"/>
                                </TextBlock>
                            </Border>
                        </StackPanel>
                    </DockPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <views:TrendChartView Grid.Column="0" x:Name="RxTrendChart"
                                              Title="处方量趋势" Height="180"/>
                        <views:TrendChartView Grid.Column="2" x:Name="RevenueTrendChart"
                                              Title="收入趋势（元）" Height="180"
                                              LineColor="#16A34A" ValueFormat="F0"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ════ 药品销量 Top（阶段三 · 报表图表化） ════ -->
            <Border Style="{StaticResource CardBorder}" Background="White">
                <StackPanel Margin="12">
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock Text="药品销量 Top" FontSize="{StaticResource FontSizeSmall}" FontWeight="SemiBold"
                                   Foreground="{StaticResource Gray900Brush}" VerticalAlignment="Center"/>
                        <ComboBox DockPanel.Dock="Right" Width="96" Height="24" VerticalContentAlignment="Center"
                                  SelectedIndex="{Binding SelectedSalesRange, Mode=TwoWay}">
                            <ComboBoxItem Content="近7天"/>
                            <ComboBoxItem Content="近30天"/>
                            <ComboBoxItem Content="本月"/>
                        </ComboBox>
                    </DockPanel>

                    <!-- 有数据：条形图列表 -->
                    <Border>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasTopDrugSales}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <ItemsControl ItemsSource="{Binding TopDrugSales}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4,0,4">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="5"/>
                                        </Grid.RowDefinitions>
                                        <DockPanel Grid.Row="0">
                                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                                <TextBlock Text="{Binding Quantity, StringFormat=×{0:F0}}" FontSize="{StaticResource FontSizeMicro}"
                                                           Foreground="{StaticResource TextMutedBrush}" Margin="4,0,0,0"/>
                                                <TextBlock Text="{Binding Amount, StringFormat=¥{0:F1}}" FontSize="{StaticResource FontSizeMicro}"
                                                           Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" Margin="6,0,0,0"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding DrugName}" FontSize="{StaticResource FontSizeMicro}"
                                                       Foreground="{StaticResource Gray700Brush}" TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                        <ProgressBar Grid.Row="1" Height="5" Minimum="0"
                                                     Maximum="{Binding DataContext.SalesMaxAmount, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                     Value="{Binding Amount}"
                                                     Background="#F3F4F6" Foreground="#2563EB" BorderThickness="0"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <!-- 无数据空态 -->
                    <Border>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasTopDrugSales}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="暂无销量数据" FontSize="{StaticResource FontSizeMicro}"
                                   Foreground="{StaticResource TextMutedBrush}" Padding="0,12"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ════ 最近处方 ════ -->
            <Border Style="{StaticResource CardBorder}" Background="White">
                <StackPanel Margin="12">
                    <TextBlock Text="最近处方" FontSize="{StaticResource FontSizeSmall}" FontWeight="SemiBold" Foreground="{StaticResource Gray900Brush}" Margin="0,0,0,8"/>
                    <DataGrid EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ItemsSource="{Binding RecentPrescriptions}"
                              IsReadOnly="True"
                              AutoGenerateColumns="False"
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column"
                              MaxHeight="250">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="处方编号" Binding="{Binding NoYearSeq}" Width="120"/>
                            <DataGridTextColumn Header="患者" Binding="{Binding PatientName}" Width="100"/>
                            <DataGridTextColumn Header="诊断" Binding="{Binding DiagnosisText}" Width="*"/>
                            <DataGridTextColumn Header="金额" Binding="{Binding TotalAmount, StringFormat=¥{0:F2}}" Width="90"/>
                            <DataGridTextColumn Header="开方时间" Binding="{Binding CreatedAt, StringFormat=MM-dd HH:mm}" Width="110"/>
                            <DataGridTextColumn Header="状态" Width="80">
                                <DataGridTextColumn.Binding>
                                    <Binding Path="Status">
                                        <Binding.Converter>
                                            <conv:PrescriptionTypeStatusConverter xmlns:conv="clr-namespace:Clinic.Presentation.Converters"/>
                                        </Binding.Converter>
                                    </Binding>
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
