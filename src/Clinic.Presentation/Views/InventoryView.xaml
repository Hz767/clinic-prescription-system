<UserControl x:Class="Clinic.Presentation.Views.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Clinic.Presentation.ViewModels"
             xmlns:views="clr-namespace:Clinic.Presentation.Views"
             xmlns:conv="clr-namespace:Clinic.Presentation.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:InventoryViewModel}"
             Background="White"
             Loaded="InventoryView_Loaded">
    <UserControl.Resources>
        <conv:NullToCollapsedConverter x:Key="NullToCollapsed"/>
        <conv:InverseBooleanConverter x:Key="InverseBool"
                                       xmlns:conv="clr-namespace:Clinic.Presentation.Converters"/>
        <conv:ExpiryStatusConverter x:Key="ExpiryStatusConverter"
                                     xmlns:conv="clr-namespace:Clinic.Presentation.Converters"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- IsBusy 全局加载指示器 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <ProgressBar IsIndeterminate="True" Width="120" Height="4"
                         HorizontalAlignment="Left"/>
            <TextBlock Text="处理中..." FontSize="12"
                       Foreground="{StaticResource PrimaryBrush}"
                       VerticalAlignment="Center" Margin="8,0,0,0"/>
        </StackPanel>

        <TabControl Grid.Row="2" SelectedIndex="{Binding CurrentTab}">

            <!-- ════════ Tab 1: 库存概览 ════════ -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconPackage}"
                              Width="16" Height="16" Stretch="Uniform"
                              Stroke="{StaticResource Gray500Brush}" StrokeThickness="2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="库存概览" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 工具栏 -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource BtnOutline}"
                                Command="{Binding ViewBatchesCommand}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                                Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconEye}"
                                      Width="16" Height="16" Stretch="Uniform"
                                      Stroke="{StaticResource Gray600Brush}" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="查看批次明细" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource BtnOutline}"
                                Command="{Binding RefreshStockSummaryCommand}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconRefresh}"
                                      Width="16" Height="16" Stretch="Uniform"
                                      Stroke="{StaticResource Gray600Brush}" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="刷新" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- 库存汇总 DataGrid -->
                    <DataGrid Grid.Row="2"
                              ItemsSource="{Binding StockSummaryList}"
                              SelectedItem="{Binding SelectedStockItem}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="药品名称" Binding="{Binding DrugName}" Width="*"/>
                            <DataGridTextColumn Header="规格" Binding="{Binding Spec}" Width="80"/>
                            <DataGridTextColumn Header="单位" Binding="{Binding Unit}" Width="50"/>
                            <DataGridTextColumn Header="总库存量" Binding="{Binding TotalQty}" Width="80"/>
                            <DataGridTextColumn Header="批次数" Binding="{Binding BatchCount}" Width="60"/>
                            <DataGridTextColumn Header="最早效期" Binding="{Binding EarliestExpiry, StringFormat=yyyy-MM-dd}" Width="100"/>
                            <DataGridTextColumn Header="零售价" Binding="{Binding RetailPrice, StringFormat=F2}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- 批次明细标题 -->
                    <TextBlock Grid.Row="4"
                               Text="批次明细"
                               Style="{StaticResource TextSectionHeader}"
                               Visibility="{Binding SelectedStockItem, Converter={StaticResource NullToCollapsed}}"/>

                    <!-- 批次明细 DataGrid -->
                    <DataGrid Grid.Row="6"
                              ItemsSource="{Binding StockBatches}"
                              Height="150"
                              Visibility="{Binding SelectedStockItem, Converter={StaticResource NullToCollapsed}}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="批号" Binding="{Binding BatchNo}" Width="*"/>
                            <DataGridTextColumn Header="效期" Binding="{Binding ExpiryDate, StringFormat=yyyy-MM-dd}" Width="100"/>
                            <DataGridTextColumn Header="剩余数量" Binding="{Binding QtyRemaining}" Width="80"/>
                            <DataGridTextColumn Header="成本价" Binding="{Binding CostPrice, StringFormat=F2}" Width="80"/>
                            <DataGridTextColumn Header="供应商" Binding="{Binding Supplier}" Width="100"/>
                            <DataGridTextColumn Header="入库时间" Binding="{Binding ReceivedAt, StringFormat=yyyy-MM-dd HH:mm}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ════════ Tab 2: 入库操作 ════════ -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconDownload}"
                              Width="16" Height="16" Stretch="Uniform"
                              Stroke="{StaticResource Gray500Brush}" StrokeThickness="2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="入库操作" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 入库表单（整体可见性绑定 CanModify） -->
                    <Border Grid.Row="0"
                            Style="{StaticResource CardBorder}"
                            Visibility="{Binding CanModify, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="入库登记" Style="{StaticResource TextSectionHeader}" Margin="0,0,0,12"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="140"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="12"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- 药品选择 -->
                                <TextBlock Grid.Row="0" Grid.Column="0"
                                           Style="{StaticResource TextLabel}" Text="药品"
                                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <ComboBox Grid.Row="0" Grid.Column="1"
                                          ItemsSource="{Binding Drugs}"
                                          SelectedItem="{Binding SelectedDrug}"
                                          DisplayMemberPath="GenericNameCn"/>

                                <!-- 批号 -->
                                <TextBlock Grid.Row="2" Grid.Column="0"
                                           Style="{StaticResource TextLabel}" Text="批号"
                                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBox Grid.Row="2" Grid.Column="1"
                                         Text="{Binding BatchNo, UpdateSourceTrigger=PropertyChanged}"
                                         VerticalContentAlignment="Center"/>

                                <!-- 效期 -->
                                <TextBlock Grid.Row="2" Grid.Column="3"
                                           Style="{StaticResource TextLabel}" Text="效期"
                                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <DatePicker Grid.Row="2" Grid.Column="4"
                                            SelectedDate="{Binding ExpiryDate}"/>

                                <!-- 数量 -->
                                <TextBlock Grid.Row="4" Grid.Column="0"
                                           Style="{StaticResource TextLabel}" Text="数量"
                                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBox Grid.Row="4" Grid.Column="1"
                                         Text="{Binding Qty, UpdateSourceTrigger=PropertyChanged}"
                                         VerticalContentAlignment="Center"/>

                                <!-- 成本价 -->
                                <TextBlock Grid.Row="4" Grid.Column="3"
                                           Style="{StaticResource TextLabel}" Text="成本价"
                                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBox Grid.Row="4" Grid.Column="4"
                                         Text="{Binding CostPrice, UpdateSourceTrigger=PropertyChanged}"
                                         VerticalContentAlignment="Center"/>

                                <!-- 供应商 -->
                                <TextBlock Grid.Row="6" Grid.Column="0"
                                           Style="{StaticResource TextLabel}" Text="供应商"
                                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBox Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="4"
                                         Text="{Binding Supplier, UpdateSourceTrigger=PropertyChanged}"/>

                                <!-- 确认入库按钮 -->
                                <Button Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="5"
                                        Style="{StaticResource BtnPrimary}"
                                        Command="{Binding StockInCommand}"
                                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                                        HorizontalAlignment="Right">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconDownload}"
                                              Width="16" Height="16" Stretch="Uniform"
                                              Stroke="White" StrokeThickness="2"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="确认入库" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 入库历史标题 + 日期筛选 -->
                    <DockPanel Grid.Row="2">
                        <TextBlock Text="入库历史" Style="{StaticResource TextSectionHeader}"
                                   VerticalAlignment="Center"/>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <TextBlock Text="从" Style="{StaticResource TextBodySmall}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <DatePicker SelectedDate="{Binding HistoryFromDate}" Width="130"/>
                            <TextBlock Text="至" Style="{StaticResource TextBodySmall}" VerticalAlignment="Center" Margin="8,0,4,0"/>
                            <DatePicker SelectedDate="{Binding HistoryToDate}" Width="130" Margin="0,0,8,0"/>
                            <Button Style="{StaticResource BtnPrimary}"
                                    Content="查询"
                                    Command="{Binding LoadStockInHistoryCommand}"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- 入库历史 DataGrid -->
                    <DataGrid Grid.Row="4"
                              ItemsSource="{Binding StockInHistory}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="药品名称" Binding="{Binding DrugName}" Width="*"/>
                            <DataGridTextColumn Header="批号" Binding="{Binding BatchNo}" Width="100"/>
                            <DataGridTextColumn Header="效期" Binding="{Binding ExpiryDate, StringFormat=yyyy-MM-dd}" Width="100"/>
                            <DataGridTextColumn Header="数量" Binding="{Binding Qty}" Width="60"/>
                            <DataGridTextColumn Header="成本价" Binding="{Binding CostPrice, StringFormat=F2}" Width="70"/>
                            <DataGridTextColumn Header="供应商" Binding="{Binding Supplier}" Width="100"/>
                            <DataGridTextColumn Header="入库时间" Binding="{Binding ReceivedAt, StringFormat=yyyy-MM-dd HH:mm}" Width="120"/>
                            <DataGridTextColumn Header="操作人" Binding="{Binding OperatorName}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ════════ Tab 3: 效期预警 ════════ -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconAlertTriangle}"
                              Width="16" Height="16" Stretch="Uniform"
                              Stroke="{StaticResource Gray500Brush}" StrokeThickness="2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="效期预警" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 刷新预警按钮 -->
                    <Button Grid.Row="0"
                            Style="{StaticResource BtnOutline}"
                            Command="{Binding LoadExpiryAlertsCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                            HorizontalAlignment="Right">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconRefresh}"
                                  Width="16" Height="16" Stretch="Uniform"
                                  Stroke="{StaticResource Gray600Brush}" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="刷新预警" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- 效期预警 DataGrid -->
                    <DataGrid Grid.Row="2"
                              ItemsSource="{Binding ExpiryAlerts}">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                <Style.Triggers>
                                    <!-- 已过期（DaysRemaining < 0）：红色背景 -->
                                    <DataTrigger Binding="{Binding DaysRemaining, Converter={StaticResource ExpiryStatusConverter}}" Value="expired">
                                        <Setter Property="Background" Value="{StaticResource ErrorBgBrush}"/>
                                        <Setter Property="Foreground" Value="{StaticResource ErrorDarkBrush}"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </DataTrigger>
                                    <!-- 即将过期（0-6 天）：橙色背景 -->
                                    <DataTrigger Binding="{Binding DaysRemaining, Converter={StaticResource ExpiryStatusConverter}}" Value="warning">
                                        <Setter Property="Background" Value="{StaticResource WarningBgBrush}"/>
                                        <Setter Property="Foreground" Value="{StaticResource WarningDarkBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="药品名称" Binding="{Binding DrugName}" Width="*"/>
                            <DataGridTextColumn Header="批号" Binding="{Binding BatchNo}" Width="100"/>
                            <DataGridTextColumn Header="效期" Binding="{Binding ExpiryDate, StringFormat=yyyy-MM-dd}" Width="100"/>
                            <DataGridTextColumn Header="剩余天数" Binding="{Binding DaysRemaining}" Width="80"/>
                            <DataGridTextColumn Header="剩余数量" Binding="{Binding QtyRemaining}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ════════ Tab 4: 手动出库 ════════ -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconUpload}"
                              Width="16" Height="16" Stretch="Uniform"
                              Stroke="{StaticResource Gray500Brush}" StrokeThickness="2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="手动出库" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 出库表单（整体可见性绑定 CanModify） -->
                    <Border Grid.Row="0"
                            Style="{StaticResource CardBorder}"
                            Visibility="{Binding CanModify, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="手动出库登记" Style="{StaticResource TextSectionHeader}" Margin="0,0,0,12"/>
                            <TextBlock Text="用于报损、调拨、过期销毁等非处方出库，按 FIFO（效期优先）策略扣减库存"
                                       Style="{StaticResource TextCaption}" Margin="0,0,0,12"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="120"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="12"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- 药品选择 -->
                                <TextBlock Grid.Row="0" Grid.Column="0"
                                           Style="{StaticResource TextLabel}" Text="药品"
                                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <ComboBox Grid.Row="0" Grid.Column="1"
                                          ItemsSource="{Binding Drugs}"
                                          SelectedItem="{Binding StockOutSelectedDrug}"
                                          DisplayMemberPath="GenericNameCn"/>

                                <!-- 数量 -->
                                <TextBlock Grid.Row="0" Grid.Column="3"
                                           Style="{StaticResource TextLabel}" Text="数量"
                                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBox Grid.Row="0" Grid.Column="4"
                                         Text="{Binding StockOutQty, UpdateSourceTrigger=PropertyChanged}"
                                         VerticalContentAlignment="Center"/>

                                <!-- 出库原因 -->
                                <TextBlock Grid.Row="2" Grid.Column="0"
                                           Style="{StaticResource TextLabel}" Text="出库原因"
                                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="4"
                                         Text="{Binding StockOutReason, UpdateSourceTrigger=PropertyChanged}"
                                         VerticalContentAlignment="Center"/>

                                <!-- 提示 -->
                                <TextBlock Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="5"
                                           Style="{StaticResource TextCaption}"
                                           Text="出库原因示例：报损、过期销毁、调拨至其他科室等"/>

                                <!-- 确认出库按钮 -->
                                <Button Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="5"
                                        Style="{StaticResource BtnWarning}"
                                        Command="{Binding StockOutCommand}"
                                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                                        HorizontalAlignment="Right">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconUpload}"
                                              Width="16" Height="16" Stretch="Uniform"
                                              Stroke="White" StrokeThickness="2"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="确认出库" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 无权限提示 -->
                    <Border Grid.Row="2"
                            Style="{StaticResource CardBorder}"
                            Visibility="{Binding CanModify, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Path Data="{StaticResource IconLock}"
                                  Width="48" Height="48" Stretch="Uniform"
                                  Stroke="{StaticResource Gray400Brush}" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  HorizontalAlignment="Center" Margin="0,0,0,12"/>
                            <TextBlock Text="出库操作需要医生或护士权限"
                                       Style="{StaticResource TextSubtitle}"
                                       HorizontalAlignment="Center"
                                       Foreground="{StaticResource Gray500Brush}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

        </TabControl>

        <!-- 状态/错误消息区 -->
        <StackPanel Grid.Row="3" Margin="0,8,0,0">
            <TextBlock Text="{Binding ErrorMessage}"
                       Style="{StaticResource TextError}"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource NullToCollapsed}}"/>
            <TextBlock Text="{Binding StatusMessage}"
                       Style="{StaticResource TextSuccess}"
                       Visibility="{Binding StatusMessage, Converter={StaticResource NullToCollapsed}}"/>
        </StackPanel>
    </Grid>
</UserControl>
