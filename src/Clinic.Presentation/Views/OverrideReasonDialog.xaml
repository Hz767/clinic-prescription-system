<Window x:Class="Clinic.Presentation.Views.OverrideReasonDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="临床覆盖确认"
        Width="520" Height="300"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource Gray50Brush}"
        ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="BlockersText"
                   FontSize="{StaticResource FontSizeCaption}" Foreground="{StaticResource ErrorBrush}"
                   TextWrapping="Wrap"
                   MaxHeight="88"/>

        <TextBlock Grid.Row="2" Text="处方存在上述阻断性问题。如医生评估后仍坚持开具（临床覆盖），请填写覆盖理由（必填，将记入审计日志）："
                   FontSize="{StaticResource FontSizeCaption}" Foreground="{StaticResource Gray700Brush}"
                   TextWrapping="Wrap"/>

        <TextBox Grid.Row="4" x:Name="ReasonInput"
                 FontSize="{StaticResource FontSizeSmall}" Padding="8,6"
                 AcceptsReturn="True" TextWrapping="Wrap"
                 Height="60"
                 VerticalContentAlignment="Top"/>

        <TextBlock Grid.Row="6" x:Name="ErrorText"
                   FontSize="{StaticResource FontSizeTiny}" Foreground="{StaticResource ErrorBrush}"
                   Visibility="Collapsed"/>

        <StackPanel Grid.Row="7" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="取消（不保存）" Width="100" Height="32"
                    Margin="0,0,8,0"
                    IsCancel="True"
                    Click="Cancel_Click"/>
            <Button Content="填写理由并保存" Width="120" Height="32"
                    IsDefault="True"
                    Background="#0D9488" Foreground="White"
                    BorderThickness="0"
                    Click="Confirm_Click"/>
        </StackPanel>
    </Grid>
</Window>
