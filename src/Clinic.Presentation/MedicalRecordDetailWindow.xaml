<Window x:Class="Clinic.Presentation.MedicalRecordDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="病历详情"
        Height="650" Width="750"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <Window.Resources>
        <conv:NullToCollapsedConverter x:Key="NullToCollapsedConverter"
                                        xmlns:conv="clr-namespace:Clinic.Presentation.Converters"/>
    </Window.Resources>
    <Grid Background="{StaticResource SurfaceDarkBrush}" Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 病历抬头 -->
        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
            <StackPanel>
                <TextBlock Text="陈医生诊所" FontSize="{StaticResource FontSizeSubtitle}" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock Text="门 诊 病 历" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock FontSize="{StaticResource FontSizeTiny}" Foreground="{StaticResource TextMutedBrush}">
                            <Run Text="患者姓名："/><Run Text="{Binding PatientName}" FontWeight="SemiBold"/>
                        </TextBlock>
                        <TextBlock FontSize="{StaticResource FontSizeTiny}" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0">
                            <Run Text="性别："/><Run Text="{Binding PatientGender}" FontWeight="SemiBold"/>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock FontSize="{StaticResource FontSizeTiny}" Foreground="{StaticResource TextMutedBrush}">
                            <Run Text="就诊医生："/><Run Text="{Binding DoctorName}" FontWeight="SemiBold"/>
                        </TextBlock>
                        <TextBlock FontSize="{StaticResource FontSizeTiny}" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0">
                            <Run Text="就诊时间："/><Run Text="{Binding VisitAt}" FontWeight="SemiBold"/>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock FontSize="{StaticResource FontSizeTiny}" Foreground="{StaticResource TextMutedBrush}">
                            <Run Text="病历编号："/><Run Text="{Binding RecordId}" FontWeight="SemiBold"/>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- 病历内容 -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <Border Background="White" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel>

                    <!-- 主诉 -->
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="主诉" FontSize="{StaticResource FontSizeSmall}" FontWeight="SemiBold" Foreground="#0F766E" Margin="0,0,0,4"/>
                        <Border Background="{StaticResource PrimaryBgBrush}" BorderBrush="#99F6E4" BorderThickness="1" CornerRadius="4" Padding="10,8">
                            <TextBlock Text="{Binding ChiefComplaint}" FontSize="{StaticResource FontSizeCaption}" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>

                    <!-- 现病史 -->
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="现病史" FontSize="{StaticResource FontSizeSmall}" FontWeight="SemiBold" Foreground="#0F766E" Margin="0,0,0,4"/>
                        <Border Background="{StaticResource Gray50Brush}" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="4" Padding="10,8">
                            <TextBlock Text="{Binding PresentIllness}" FontSize="{StaticResource FontSizeCaption}" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>

                    <!-- 查体 -->
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="体格检查" FontSize="{StaticResource FontSizeSmall}" FontWeight="SemiBold" Foreground="#0F766E" Margin="0,0,0,4"/>
                        <Border Background="{StaticResource Gray50Brush}" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="4" Padding="10,8">
                            <TextBlock Text="{Binding Exam}" FontSize="{StaticResource FontSizeCaption}" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>

                    <!-- 辅助检查 -->
                    <StackPanel Margin="0,0,0,12"
                                Visibility="{Binding AuxiliaryExam, Converter={StaticResource NullToCollapsedConverter}}">
                        <TextBlock Text="辅助检查" FontSize="{StaticResource FontSizeSmall}" FontWeight="SemiBold" Foreground="#0F766E" Margin="0,0,0,4"/>
                        <Border Background="{StaticResource Gray50Brush}" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="4" Padding="10,8">
                            <TextBlock Text="{Binding AuxiliaryExam}" FontSize="{StaticResource FontSizeCaption}" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>

                    <!-- 诊断 -->
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="诊断" FontSize="{StaticResource FontSizeSmall}" FontWeight="SemiBold" Foreground="{StaticResource ErrorBrush}" Margin="0,0,0,4"/>
                        <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="4" Padding="10,8">
                            <TextBlock Text="{Binding Diagnosis}" FontSize="{StaticResource FontSizeCaption}" Foreground="#991B1B" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>

                    <!-- 处理计划 -->
                    <StackPanel Margin="0,0,0,4">
                        <TextBlock Text="处理计划" FontSize="{StaticResource FontSizeSmall}" FontWeight="SemiBold" Foreground="#0F766E" Margin="0,0,0,4"/>
                        <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="4" Padding="10,8">
                            <TextBlock Text="{Binding Plan}" FontSize="{StaticResource FontSizeCaption}" Foreground="#1E3A8A" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>

                </StackPanel>
            </Border>
        </ScrollViewer>

        <!-- 底部按钮 -->
        <Border Grid.Row="4" Background="White" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="关闭" Width="100"
                        Click="CloseButton_Click"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
