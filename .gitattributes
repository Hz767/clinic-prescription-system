# 自动检测文本文件并规范化行尾
* text=auto eol=lf

# C# 源文件
*.cs text eol=lf diff=csharp
*.csproj text eol=lf
*.sln text eol=lf
*.props text eol=lf
*.targets text eol=lf

# XAML / XML / 配置
*.xaml text eol=lf
*.xml text eol=lf
*.json text eol=lf
*.config text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# 文档
*.md text eol=lf
*.txt text eol=lf

# SQL
*.sql text eol=lf

# 脚本
*.sh text eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制文件（不转换行尾）
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text eol=lf
*.pdf binary
*.zip binary
*.nupkg binary
*.db binary
*.db-shm binary
*.db-wal binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary

# Visual Studio
*.suo binary
*.user binary
*.userosscache binary
*.sln.docstates binary

# 程序集与可执行文件
*.exe binary
*.dll binary
*.so binary
*.dylib binary

# AI 模型（大体积二进制）
*.gguf binary
*.onnx binary
*.safetensors binary

# 媒体与 Office 文档
*.mp3 binary
*.wav binary
*.mp4 binary
*.mov binary
*.docx binary
*.xlsx binary
*.pptx binary

# 证书与密钥（即使被忽略，也不做行尾转换）
*.p12 binary
*.pfx binary
*.pem binary
*.crt binary

# 编辑器配置与数据文件
*.editorconfig text eol=lf
*.csv text eol=lf
