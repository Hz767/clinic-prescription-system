<UserControl x:Class="Clinic.Presentation.Views.PrescriptionHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Clinic.Presentation.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:PrescriptionHistoryViewModel}"
             Background="White">
    <UserControl.Resources>
        <conv:NullToCollapsedConverter x:Key="NullToCollapsed"
                                        xmlns:conv="clr-namespace:Clinic.Presentation.Converters"/>
        <conv:PrescriptionTypeStatusConverter x:Key="PrescriptionTypeStatusConverter"
                                               xmlns:conv="clr-namespace:Clinic.Presentation.Converters"/>
        <conv:InverseBooleanConverter x:Key="InverseBool"
                                       xmlns:conv="clr-namespace:Clinic.Presentation.Converters"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- IsBusy 全局加载指示器 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <ProgressBar IsIndeterminate="True" Width="120" Height="4"
                         HorizontalAlignment="Left"/>
            <TextBlock Text="处理中..." FontSize="{StaticResource FontSizeCaption}"
                       Foreground="{StaticResource PrimaryBrush}"
                       VerticalAlignment="Center" Margin="8,0,0,0"/>
        </StackPanel>

        <!-- 搜索栏 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="关键词" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <TextBox Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                     Width="200" Margin="0,0,12,0"/>
            <TextBlock Text="从" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <DatePicker SelectedDate="{Binding FromDate, Mode=TwoWay}" Width="140" Margin="0,0,8,0"/>
            <TextBlock Text="到" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <DatePicker SelectedDate="{Binding ToDate, Mode=TwoWay}" Width="140" Margin="0,0,12,0"/>
            <Button Content="搜索"
                    Command="{Binding SearchCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                    Padding="16,6"/>
        </StackPanel>

        <!-- 消息区 -->
        <TextBlock Grid.Row="3" Text="{Binding StatusMessage}"
                   Foreground="{StaticResource SuccessBrush}" FontSize="{StaticResource FontSizeCaption}" Margin="0,0,0,8"
                   Visibility="{Binding StatusMessage, Converter={StaticResource NullToCollapsed}}"/>
        <TextBlock Grid.Row="3" Text="{Binding ErrorMessage}"
                   Foreground="{StaticResource ErrorBrush}" FontSize="{StaticResource FontSizeCaption}" Margin="0,0,0,8"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource NullToCollapsed}}"/>

        <!-- 处方列表 -->
        <DataGrid EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" Grid.Row="4"
                  ItemsSource="{Binding Prescriptions}"
                  SelectedItem="{Binding SelectedPrescription}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  MouseDoubleClick="PrescriptionDataGrid_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="处方编号" Binding="{Binding NoYearSeq}" Width="120"/>
                <DataGridTextColumn Header="患者姓名" Binding="{Binding PatientName}" Width="100"/>
                <DataGridTextColumn Header="医生" Binding="{Binding DoctorName}" Width="80"/>
                <DataGridTextColumn Header="诊断" Binding="{Binding DiagnosisText}" Width="*"/>
                <DataGridTextColumn Header="药品数" Binding="{Binding ItemCount}" Width="60"/>
                <DataGridTextColumn Header="总金额" Binding="{Binding TotalAmount, StringFormat=C}" Width="80"/>
                <DataGridTextColumn Header="类型" Binding="{Binding Type, Converter={StaticResource PrescriptionTypeStatusConverter}, ConverterParameter=Type}" Width="60"/>
                <DataGridTextColumn Header="状态" Binding="{Binding Status, Converter={StaticResource PrescriptionTypeStatusConverter}, ConverterParameter=Status}" Width="60"/>
                <DataGridTextColumn Header="开具时间" Binding="{Binding CreatedAt, StringFormat=yyyy-MM-dd HH:mm}" Width="140"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 操作按钮 -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <!-- 前往收费按钮（仅已保存/已审核处方可见） -->
            <Button Content="前往收费"
                    Command="{Binding GoToBillingCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                    Visibility="{Binding CanGoToBillingSelected, Converter={StaticResource BoolToVis}}"
                    Style="{StaticResource BtnPrimary}"
                    Padding="16,8" Margin="0,0,8,0"/>
            <!-- 作废原因输入（仅对可作废处方可见） -->
            <TextBlock Text="作废原因：" VerticalAlignment="Center"
                       Visibility="{Binding CanVoidSelected, Converter={StaticResource BoolToVis}}"/>
            <TextBox Text="{Binding VoidReason, UpdateSourceTrigger=PropertyChanged}"
                     Width="150" Margin="4,0,8,0"
                     Visibility="{Binding CanVoidSelected, Converter={StaticResource BoolToVis}}"/>
            <Button Content="作废处方"
                    Command="{Binding VoidPrescriptionCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                    Visibility="{Binding CanVoidSelected, Converter={StaticResource BoolToVis}}"
                    Style="{StaticResource BtnDanger}"
                    Padding="16,8" Margin="0,0,8,0"/>
            <Button Content="重新打印 PDF"
                    Command="{Binding ReprintPdfCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                    Padding="16,8" Margin="0,0,8,0"/>
        </StackPanel>
    </Grid>
</UserControl>
