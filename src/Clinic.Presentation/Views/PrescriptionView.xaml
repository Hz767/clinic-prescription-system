<UserControl x:Class="Clinic.Presentation.Views.PrescriptionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Clinic.Presentation.ViewModels"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:PrescriptionViewModel}"
             Background="#F3F4F6"
             Loaded="PrescriptionView_Loaded">
    <UserControl.Resources>
        <conv:NullToCollapsedConverter x:Key="NullToCollapsed"
                                        xmlns:conv="clr-namespace:Clinic.Presentation.Converters"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"
                                        xmlns:conv="clr-namespace:Clinic.Presentation.Converters"/>
        <conv:DecimalInputConverter x:Key="DecimalInput"
                                     xmlns:conv="clr-namespace:Clinic.Presentation.Converters"/>
        <x:Array x:Key="DoseUnits" Type="sys:String"
                 xmlns:sys="clr-namespace:System;assembly=System.Runtime">
            <sys:String>片</sys:String>
            <sys:String>粒</sys:String>
            <sys:String>袋</sys:String>
            <sys:String>支</sys:String>
            <sys:String>瓶</sys:String>
            <sys:String>mg</sys:String>
            <sys:String>ml</sys:String>
        </x:Array>
        <x:Array x:Key="Frequencies" Type="sys:String"
                 xmlns:sys="clr-namespace:System;assembly=System.Runtime">
            <sys:String>每日一次</sys:String>
            <sys:String>每日两次</sys:String>
            <sys:String>每日三次</sys:String>
            <sys:String>每晚一次</sys:String>
            <sys:String>必要时</sys:String>
        </x:Array>
        <x:Array x:Key="Routes" Type="sys:String"
                 xmlns:sys="clr-namespace:System;assembly=System.Runtime">
            <sys:String>口服</sys:String>
            <sys:String>外用</sys:String>
            <sys:String>静脉注射</sys:String>
            <sys:String>肌肉注射</sys:String>
            <sys:String>吸入</sys:String>
            <sys:String>含服</sys:String>
        </x:Array>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="6"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ════════════════ 左侧：输入面板 ════════════════ -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Background="White">
            <StackPanel Margin="12">

                <!-- ── 患者信息 + 体征 ── -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="患者信息" Style="{StaticResource TextSectionHeader}" Margin="0,0,0,8"/>
                        <TextBlock Text="输入姓名或手机号，自动联想匹配" Style="{StaticResource TextCaption}" Margin="0,0,0,6"/>

                        <TextBox x:Name="PatientSearchBox"
                                 Text="{Binding PatientSearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalContentAlignment="Center"
                                 GotFocus="PatientSearchBox_GotFocus"
                                 LostFocus="PatientSearchBox_LostFocus"/>

                        <Border Visibility="{Binding ShowPatientDropdown, Converter={StaticResource BoolToVisibility}}"
                                Background="White" BorderBrush="#D1D5DB" BorderThickness="1"
                                CornerRadius="4" MaxHeight="240" Margin="0,2,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- 搜索结果列表（有匹配时显示） -->
                                <ListBox Grid.Row="0" x:Name="PatientListBox"
                                         ItemsSource="{Binding FilteredPatients}"
                                         BorderThickness="0"
                                         PreviewMouseLeftButtonUp="PatientListBox_PreviewMouseLeftButtonUp"
                                         Visibility="{Binding HasNoResults, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="4,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock FontWeight="SemiBold">
                                                        <Run Text="{Binding Name, Mode=OneWay}"/>
                                                        <Run Text="  " FontSize="10"/>
                                                        <Run Text="{Binding Gender, Mode=OneWay}" FontSize="11" Foreground="#6B7280"/>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding Phone}" FontSize="11" Foreground="#6B7280"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                                           FontSize="9" Foreground="#6B7280"
                                                           Text="{Binding ChronicTags}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <!-- 无匹配时提示 -->
                                <TextBlock Grid.Row="0" Text="未找到匹配患者" Foreground="#6B7280" FontSize="12"
                                           Margin="12,10" HorizontalAlignment="Left" VerticalAlignment="Top"
                                           Visibility="{Binding HasNoResults, Converter={StaticResource BoolToVisibility}}"/>

                                <!-- 新建患者档案按钮（始终显示在下拉底部） -->
                                <Border Grid.Row="1" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Padding="8,6">
                                    <Button Style="{StaticResource BtnOutlineSm}"
                                            Command="{Binding ToggleQuickRegistrationCommand}"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"
                                                  Width="12" Height="12" Stretch="Uniform" Margin="0,0,4,0"
                                                  VerticalAlignment="Center"
                                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                            <TextBlock Text="新建患者档案" VerticalAlignment="Center" FontSize="11"/>
                                        </StackPanel>
                                    </Button>
                                </Border>
                            </Grid>
                        </Border>

                        <Border Visibility="{Binding IsQuickRegistration, Converter={StaticResource BoolToVisibility}}"
                                Background="#F9FAFB" CornerRadius="6" Padding="12,10" Margin="0,6,0,0"
                                BorderBrush="#D1D5DB" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="快速建档" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8"/>

                                <!-- 姓名 + 性别 -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="姓名" FontSize="11" Foreground="#6B7280"
                                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBox Grid.Column="1"
                                             Text="{Binding NewPatientName, UpdateSourceTrigger=PropertyChanged}"
                                             VerticalContentAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="性别" FontSize="11" Foreground="#6B7280"
                                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <ComboBox Grid.Column="4"
                                              SelectedValue="{Binding NewPatientGender}"
                                              SelectedValuePath="Content"
                                              VerticalContentAlignment="Center">
                                        <ComboBoxItem Content="男"/>
                                        <ComboBoxItem Content="女"/>
                                    </ComboBox>
                                </Grid>

                                <!-- 手机号 -->
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="手机号" FontSize="11" Foreground="#6B7280"
                                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBox Grid.Column="1"
                                             Text="{Binding NewPatientPhone, UpdateSourceTrigger=PropertyChanged}"
                                             VerticalContentAlignment="Center"/>
                                </Grid>
                                <!-- 手机号验证错误提示 -->
                                <TextBlock Text="{Binding NewPatientPhoneError}"
                                           FontSize="10" Foreground="#DC2626" Margin="44,2,0,0"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding NewPatientPhoneError, Converter={StaticResource NullToCollapsed}}"/>

                                <!-- 出生日期 -->
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="出生日期" FontSize="11" Foreground="#6B7280"
                                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <DatePicker Grid.Column="1"
                                                SelectedDate="{Binding NewPatientDob}"
                                                VerticalContentAlignment="Center"
                                                Height="28"/>
                                </Grid>

                                <!-- 过敏史 -->
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="过敏史" FontSize="11" Foreground="#6B7280"
                                               VerticalAlignment="Top" Margin="0,4,6,0"/>
                                    <TextBox Grid.Column="1"
                                             Text="{Binding NewPatientAllergies, UpdateSourceTrigger=PropertyChanged}"
                                             VerticalContentAlignment="Center"
                                             ToolTip="如有药物过敏请填写，如：青霉素、磺胺类"
                                             Height="28"/>
                                </Grid>

                                <!-- 基础疾病（慢病史） -->
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="基础疾病" FontSize="11" Foreground="#6B7280"
                                               VerticalAlignment="Top" Margin="0,4,6,0"/>
                                    <TextBox Grid.Column="1"
                                             Text="{Binding NewPatientChronicTags, UpdateSourceTrigger=PropertyChanged}"
                                             VerticalContentAlignment="Center"
                                             ToolTip="如有慢性病请填写，如：高血压、糖尿病、冠心病"
                                             Height="28"/>
                                </Grid>

                                <DockPanel Margin="0,8,0,0">
                                    <Button DockPanel.Dock="Right"
                                            Style="{StaticResource BtnPrimarySm}"
                                            Content="确认建档并选择"
                                            Command="{Binding CreateNewPatientCommand}"/>
                                    <Button Style="{StaticResource BtnOutlineSm}"
                                            Content="取消"
                                            Command="{Binding ToggleQuickRegistrationCommand}"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <Border Visibility="{Binding SelectedPatient, Converter={StaticResource NullToCollapsed}}"
                                Background="#F0FDF4" CornerRadius="6" Padding="10,8"
                                Margin="0,8,0,0" BorderBrush="#A7F3D0" BorderThickness="1">
                            <StackPanel>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource BtnOutlineSm}"
                                            Content="清除" FontSize="11" Padding="8,2"
                                            Command="{Binding SelectPatientCommand}"
                                            CommandParameter="{x:Null}"/>
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold" FontSize="13">
                                            <Run Text="已选患者：" Foreground="#6B7280"/>
                                            <Run Text="{Binding SelectedPatient.Name, Mode=OneWay}" Foreground="#0D9488"/>
                                        </TextBlock>
                                        <TextBlock FontSize="11" Foreground="#6B7280" Margin="0,2,0,0">
                                            <Run Text="{Binding SelectedPatient.Gender, Mode=OneWay}"/>
                                            <Run Text=" | "/>
                                            <Run Text="{Binding SelectedPatientAgeText, Mode=OneWay}"/>
                                            <Run Text=" | "/>
                                            <Run Text="{Binding SelectedPatient.Phone, Mode=OneWay}"/>
                                        </TextBlock>
                                        <TextBlock FontSize="11" Margin="0,2,0,0">
                                            <Run Text="过敏史：" Foreground="#6B7280"/>
                                            <Run Text="{Binding SelectedPatientAllergyText, Mode=OneWay}" Foreground="#DC2626"/>
                                        </TextBlock>
                                        <TextBlock FontSize="11" Margin="0,1,0,0">
                                            <Run Text="基础疾病：" Foreground="#6B7280"/>
                                            <Run Text="{Binding SelectedPatientChronicText, Mode=OneWay}" Foreground="#374151"/>
                                        </TextBlock>
                                    </StackPanel>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ── 就诊体征（实时变量，本次就诊测量，保存到处方记录） ── -->
                <Border Style="{StaticResource CardBorder}" Margin="0,10,0,0">
                    <StackPanel>
                        <!-- 可折叠标题 -->
                        <DockPanel Margin="0,0,0,0">
                            <ToggleButton DockPanel.Dock="Right" IsChecked="{Binding IsVitalSignsExpanded, Mode=TwoWay}"
                                          FontSize="10" Padding="4,0" Background="Transparent" BorderThickness="0" Cursor="Hand">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton">
                                        <Setter Property="Content" Value="▶"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter Property="Content" Value="▼"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ToggleButton.Style>
                            </ToggleButton>
                            <TextBlock Text="就诊体征" Style="{StaticResource TextSectionHeader}"/>
                        </DockPanel>
                        <!-- 折叠内容 -->
                        <StackPanel Visibility="{Binding IsVitalSignsExpanded, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="本次就诊实时测量，保存到处方记录中（非患者长期数据）" Style="{StaticResource TextCaption}" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="55"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="55"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="45"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="45"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="55"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="体重:" VerticalAlignment="Center" FontSize="11" Margin="0,0,4,0"/>
                            <TextBox Grid.Column="1" Text="{Binding PatientWeight, Converter={StaticResource DecimalInput}, UpdateSourceTrigger=PropertyChanged}"
                                     VerticalContentAlignment="Center" FontSize="11" Height="24" Padding="4,1"
                                     PreviewTextInput="NumericOnly_PreviewTextInput"/>
                            <TextBlock Grid.Column="2" Text="kg" VerticalAlignment="Center" FontSize="11" Foreground="#6B7280"/>
                            <TextBlock Grid.Column="4" Text="体温:" VerticalAlignment="Center" FontSize="11" Margin="0,0,4,0"/>
                            <TextBox Grid.Column="5" Text="{Binding PatientTemperature, Converter={StaticResource DecimalInput}, UpdateSourceTrigger=PropertyChanged}"
                                     VerticalContentAlignment="Center" FontSize="11" Height="24" Padding="4,1"
                                     PreviewTextInput="NumericOnly_PreviewTextInput"/>
                            <TextBlock Grid.Column="6" Text="°C" VerticalAlignment="Center" FontSize="11" Foreground="#6B7280"/>
                            <TextBlock Grid.Column="8" Text="血压:" VerticalAlignment="Center" FontSize="11" Margin="0,0,4,0"/>
                            <TextBox Grid.Column="9" Text="{Binding PatientSystolicBP, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                                     VerticalContentAlignment="Center" FontSize="11" Height="24" Padding="4,1"
                                     PreviewTextInput="NumericOnly_PreviewTextInput"/>
                            <TextBlock Grid.Column="10" Text="/" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="11"/>
                            <TextBox Grid.Column="11" Text="{Binding PatientDiastolicBP, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                                     VerticalContentAlignment="Center" FontSize="11" Height="24" Margin="2,0,0,0" Padding="4,1"
                                     PreviewTextInput="NumericOnly_PreviewTextInput"/>
                            <TextBlock Grid.Column="13" Text="心率:" VerticalAlignment="Center" FontSize="11" Margin="0,0,4,0"/>
                            <TextBox Grid.Column="14" Text="{Binding PatientHeartRate, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                                     VerticalContentAlignment="Center" FontSize="11" Height="24" Width="55" Padding="4,1"
                                     PreviewTextInput="NumericOnly_PreviewTextInput"/>
                        </Grid>

                        <!-- 正常参考范围提示 -->
                        <TextBlock Margin="0,4,0,0" FontSize="10" Foreground="#9CA3AF" TextWrapping="Wrap"
                                   Text="参考范围：体重2-200kg | 体温36-37.3°C | 血压90-140/60-90mmHg | 心率60-100次/分"/>

                        <!-- 体征异常警告（实时检查，输入即验证） -->
                        <Border Margin="0,6,0,0" CornerRadius="4" Padding="8,5"
                                Visibility="{Binding HasVitalSignsWarning, Converter={StaticResource BoolToVisibility}}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#FEF3C7"/>
                                    <Setter Property="BorderBrush" Value="#FCD34D"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding VitalSignsWarningLevel}" Value="2">
                                            <Setter Property="Background" Value="#FEE2E2"/>
                                            <Setter Property="BorderBrush" Value="#FCA5A5"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding VitalSignsWarning}" FontSize="11" TextWrapping="Wrap"
                                       Foreground="#92400E">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding VitalSignsWarningLevel}" Value="2">
                                                <Setter Property="Foreground" Value="#991B1B"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ── 历史病历（选中患者后自动展示，帮助医生快速了解病史） ── -->
                <Border Style="{StaticResource CardBorder}" Margin="0,10,0,0"
                        Visibility="{Binding HasPatientHistory, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <!-- 可折叠标题 -->
                        <DockPanel>
                            <ToggleButton DockPanel.Dock="Right" IsChecked="{Binding IsHistoryExpanded, Mode=TwoWay}"
                                          FontSize="10" Padding="4,0" Background="Transparent" BorderThickness="0" Cursor="Hand">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton">
                                        <Setter Property="Content" Value="▶"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter Property="Content" Value="▼"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ToggleButton.Style>
                            </ToggleButton>
                            <TextBlock Text="历史病历" Style="{StaticResource TextSectionHeader}"/>
                        </DockPanel>
                        <!-- 折叠内容 -->
                        <StackPanel Visibility="{Binding IsHistoryExpanded, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="该患者近期就诊记录（最多10条）" Style="{StaticResource TextCaption}" Margin="0,0,0,6"/>
                        <ItemsControl ItemsSource="{Binding PatientHistory}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#F9FAFB" CornerRadius="4" Padding="8,6" Margin="0,0,0,4"
                                            BorderBrush="#E5E7EB" BorderThickness="1">
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" FontSize="11" Foreground="#6B7280"
                                                           VerticalAlignment="Center"
                                                           Text="{Binding CreatedAt, StringFormat='yyyy-MM-dd HH:mm'}"/>
                                                <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#0D9488">
                                                    <Run Text="{Binding NoYearSeq, Mode=OneWay}"/>
                                                </TextBlock>
                                            </DockPanel>
                                            <TextBlock FontSize="11" Foreground="#374151" Margin="0,2,0,0"
                                                       Text="{Binding DiagnosisText}"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxWidth="280"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <TextBlock FontSize="10" Foreground="#6B7280">
                                                    <Run Text="{Binding DoctorName, Mode=OneWay}"/>
                                                    <Run Text=" | "/>
                                                    <Run Text="{Binding ItemCount, Mode=OneWay}"/>
                                                    <Run Text="种药品 | ¥"/>
                                                    <Run Text="{Binding TotalAmount, Mode=OneWay, StringFormat=F2}"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ── 主诉 ── -->
                <Border Style="{StaticResource CardBorder}" Margin="0,10,0,0">
                    <StackPanel>
                        <!-- 可折叠标题 -->
                        <DockPanel>
                            <ToggleButton DockPanel.Dock="Right" IsChecked="{Binding IsChiefComplaintExpanded, Mode=TwoWay}"
                                          FontSize="10" Padding="4,0" Background="Transparent" BorderThickness="0" Cursor="Hand">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton">
                                        <Setter Property="Content" Value="▶"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter Property="Content" Value="▼"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ToggleButton.Style>
                            </ToggleButton>
                            <TextBlock Text="主诉" Style="{StaticResource TextSectionHeader}"/>
                        </DockPanel>
                        <!-- 折叠内容 -->
                        <StackPanel Visibility="{Binding IsChiefComplaintExpanded, Converter={StaticResource BoolToVisibility}}">
                        <TextBox Text="{Binding ChiefComplaint, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="点击下方常见主诉标签添加，也可手动输入"
                                 Height="28" VerticalContentAlignment="Center"/>
                        <TextBlock Text="常见主诉（点击添加，可多选）" Style="{StaticResource TextCaption}" Margin="0,6,0,3"/>
                        <ScrollViewer MaxHeight="60" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding CommonChiefComplaints}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding}"
                                                Command="{Binding DataContext.AddChiefComplaintCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Padding="6,2" Margin="0,0,4,4"
                                                FontSize="11"
                                                Background="#FFF3E0" BorderBrush="#FFCC80"
                                                Foreground="#E65100"
                                                Cursor="Hand"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ── 诊断 ── -->
                <Border Style="{StaticResource CardBorder}" Margin="0,10,0,0">
                    <StackPanel>
                        <!-- 可折叠标题（含处方类型和AI按钮） -->
                        <DockPanel Margin="0,0,0,6">
                            <ToggleButton DockPanel.Dock="Right" IsChecked="{Binding IsDiagnosisExpanded, Mode=TwoWay}"
                                          FontSize="10" Padding="4,0" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                          VerticalAlignment="Center">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton">
                                        <Setter Property="Content" Value="▶"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter Property="Content" Value="▼"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ToggleButton.Style>
                            </ToggleButton>
                            <TextBlock Text="诊断" Style="{StaticResource TextSectionHeader}" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" Margin="0,0,8,0">
                                <TextBlock Text="处方类型:" VerticalAlignment="Center" FontSize="11" Margin="0,0,4,0"/>
                                <ComboBox SelectedIndex="{Binding PrescriptionType}" Width="90" FontSize="11">
                                    <ComboBoxItem Content="普通处方"/>
                                    <ComboBoxItem Content="急诊处方"/>
                                    <ComboBoxItem Content="儿科处方"/>
                                </ComboBox>
                                <Button Style="{StaticResource BtnOutlineSm}"
                                        Content="AI生成病历"
                                        Command="{Binding GenerateMedicalRecordCommand}"
                                        Visibility="{Binding LlmIsAvailable, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}"
                                        Margin="8,0,0,0"/>
                            </StackPanel>
                        </DockPanel>
                        <!-- 折叠内容 -->
                        <StackPanel Visibility="{Binding IsDiagnosisExpanded, Converter={StaticResource BoolToVisibility}}">

                        <TextBox Text="{Binding DiagnosisText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="点击下方常见诊断标签添加，也可手动输入"
                                 Height="28" VerticalContentAlignment="Center"/>

                        <TextBlock Text="常见诊断（点击添加，可多选）" Style="{StaticResource TextCaption}" Margin="0,6,0,3"/>
                        <ScrollViewer MaxHeight="80" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="DiagnosisChips" ItemsSource="{Binding CommonDiagnoses}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding}"
                                                Command="{Binding DataContext.AddDiagnosisCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Padding="6,2" Margin="0,0,4,4"
                                                FontSize="11"
                                                Background="#E8F4FD" BorderBrush="#B3D9F2"
                                                Foreground="#1565C0"
                                                Cursor="Hand"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- AI病历结果（可编辑，确认后使用） -->
                        <Border Background="#F0F7FF" BorderBrush="#B3D9F2" BorderThickness="1"
                                CornerRadius="4" Padding="8" Margin="0,6,0,0"
                                Visibility="{Binding HasAiDiagnosisResult, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="AI生成病历（可编辑，确认后使用）" FontSize="11" FontWeight="SemiBold"
                                           Foreground="#1565C0" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding AiDiagnosisResult, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True" TextWrapping="Wrap"
                                         MinHeight="60" MaxHeight="120"
                                         VerticalScrollBarVisibility="Auto"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                                    <Button Style="{StaticResource BtnOutlineSm}"
                                            Content="放弃"
                                            Command="{Binding ClearAiDiagnosisCommand}"
                                            Margin="0,0,6,0"/>
                                    <Button Style="{StaticResource BtnPrimarySm}"
                                            Content="确认使用"
                                            Command="{Binding ConfirmAiDiagnosisCommand}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ── 药品选择 ── -->
                <Border Style="{StaticResource CardBorder}" Margin="0,10,0,0">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="药品选择" Style="{StaticResource TextSectionHeader}" VerticalAlignment="Center"/>
                            <Border DockPanel.Dock="Right" Style="{StaticResource AiPanelBorder}" Margin="8,0,0,0"
                                    Visibility="{Binding LlmIsAvailable, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right"
                                            Style="{StaticResource BtnOutlineSm}"
                                            Content="AI整理"
                                            Command="{Binding ParsePrescriptionCommand}"
                                            Margin="4,0,0,0"/>
                                    <TextBox Text="{Binding LlmPrescriptionInput, UpdateSourceTrigger=PropertyChanged}"
                                             Height="24" Width="160" FontSize="11"
                                             VerticalContentAlignment="Center"
                                             ToolTip="如「阿莫西林一天三次一次两粒吃七天」"/>
                                </DockPanel>
                            </Border>
                        </DockPanel>

                        <DockPanel Margin="0,0,0,6">
                            <TextBlock DockPanel.Dock="Left" Text="🔍" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox Text="{Binding DrugFilter, UpdateSourceTrigger=PropertyChanged}"
                                     VerticalContentAlignment="Center"
                                     ToolTip="输入药品名称或规格进行模糊搜索"/>
                        </DockPanel>

                        <DataGrid x:Name="DrugDataGrid"
                                  ItemsSource="{Binding Drugs}"
                                  SelectedItem="{Binding SelectedDrug}"
                                  IsReadOnly="True"
                                  SelectionMode="Single"
                                  AutoGenerateColumns="False"
                                  Height="140"
                                  MouseDoubleClick="DrugDataGrid_MouseDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="药品名称" Binding="{Binding GenericNameCn}" Width="*"/>
                                <DataGridTextColumn Header="规格" Binding="{Binding Spec}" Width="80"/>
                                <DataGridTextColumn Header="单位" Binding="{Binding Unit}" Width="50"/>
                                <DataGridTextColumn Header="单价" Binding="{Binding RetailPriceRef, StringFormat=F2}" Width="70"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="提示：双击药品行可快速添加到处方明细，用法用量可在右侧处方单中直接修改"
                                   Style="{StaticResource TextCaption}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="#E5E7EB"/>

        <!-- ════════════════ 右侧：模拟病历单 + 处方单 ════════════════ -->
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Background="#F3F4F6">
            <StackPanel Margin="12">

                <!-- ── 模拟病历单 ── -->
                <Border Background="White" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="2"
                        Margin="0,0,0,10">
                    <StackPanel Margin="16,12">
                        <!-- 病历标题 -->
                        <TextBlock Text="陈医生诊所" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"
                                   FontFamily="Microsoft YaHei"/>
                        <TextBlock Text="门 诊 病 历" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"
                                   Margin="0,2,0,8" FontFamily="Microsoft YaHei"/>
                        <Line X1="0" Y1="0" X2="1" Y2="0" Stretch="Fill" Stroke="#9CA3AF" StrokeThickness="1" Margin="0,0,0,8"/>

                        <!-- 患者基本信息 -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="姓名：" FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding SelectedPatient.Name, FallbackValue='—'}" FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="性别：" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            <TextBlock Grid.Column="3" Text="{Binding SelectedPatient.Gender, FallbackValue='—'}" FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="4" Text="电话：" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            <TextBlock Grid.Column="5" Text="{Binding SelectedPatient.Phone, FallbackValue='—'}" FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="6" Text="日期：" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            <TextBlock Grid.Column="7" Text="{Binding Source={x:Static sys:DateTime.Now}, StringFormat='yyyy-MM-dd'}" FontSize="11" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- 主诉 -->
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="主  诉：" FontSize="11" VerticalAlignment="Top" Margin="0,4,0,0"/>
                            <TextBox Grid.Column="1" Text="{Binding ChiefComplaint, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="11" BorderThickness="0,0,0,1" BorderBrush="#D1D5DB"
                                     Background="Transparent" Padding="0,2"
                                     MinHeight="24" VerticalContentAlignment="Center"
                                     ToolTip="可直接编辑主诉内容"/>
                        </Grid>

                        <!-- 病史/处置（AI生成病历） -->
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="病  史：" FontSize="11" VerticalAlignment="Top" Margin="0,4,0,0"/>
                            <TextBox Grid.Column="1" Text="{Binding AiDiagnosisResult, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                                     FontSize="11" BorderThickness="0,0,0,1" BorderBrush="#D1D5DB"
                                     Background="Transparent" Padding="0,2"
                                     AcceptsReturn="True" TextWrapping="Wrap"
                                     MinHeight="50" MaxHeight="100"
                                     VerticalScrollBarVisibility="Auto"
                                     ToolTip="AI辅助生成病历内容，可直接编辑"/>
                        </Grid>

                        <!-- 体征 -->
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="体  征：" FontSize="11" VerticalAlignment="Top" Margin="0,4,0,0"/>
                            <TextBlock Grid.Column="1" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0">
                                <Run Text="T "/><Run Text="{Binding PatientTemperature, FallbackValue='—'}"/><Run Text="°C    "/>
                                <Run Text="P "/><Run Text="{Binding PatientHeartRate, FallbackValue='—'}"/><Run Text="次/分    "/>
                                <Run Text="BP "/><Run Text="{Binding PatientSystolicBP, FallbackValue='—'}"/><Run Text="/"/><Run Text="{Binding PatientDiastolicBP, FallbackValue='—'}"/><Run Text="mmHg    "/>
                                <Run Text="Wt "/><Run Text="{Binding PatientWeight, FallbackValue='—'}"/><Run Text="kg"/>
                            </TextBlock>
                        </Grid>

                        <!-- 诊断 -->
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="诊  断：" FontSize="11" VerticalAlignment="Top" Margin="0,4,0,0"/>
                            <TextBox Grid.Column="1" Text="{Binding DiagnosisText, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="11" BorderThickness="0,0,0,1" BorderBrush="#D1D5DB"
                                     Background="Transparent" Padding="0,2"
                                     MinHeight="24" VerticalContentAlignment="Center"
                                     ToolTip="可直接编辑诊断内容"/>
                        </Grid>

                        <!-- 医生签名 -->
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1" FontSize="11" VerticalAlignment="Center">
                                <Run Text="医师签名："/>
                                <Run Text="{Binding DoctorName, FallbackValue='_______________', Mode=OneWay}" FontWeight="SemiBold"/>
                            </TextBlock>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ── 模拟处方单 ── -->
                <Border BorderBrush="#9CA3AF" BorderThickness="1" CornerRadius="2" Margin="0,0,0,10">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="White"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PrescriptionType}" Value="1">
                                    <Setter Property="Background" Value="#FFFDE7"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding PrescriptionType}" Value="2">
                                    <Setter Property="Background" Value="#F1F8E9"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Margin="16,12">
                        <!-- 处方标题 -->
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock Text="陈医生诊所" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                            <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="10">
                                <Run Text="日期："/><Run Text="{Binding Source={x:Static sys:DateTime.Now}, StringFormat='yyyy-MM-dd', Mode=OneWay}"/>
                            </TextBlock>
                        </DockPanel>
                        <TextBlock Text="处 方 笺" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"
                                   Margin="0,2,0,4" FontFamily="Microsoft YaHei"/>

                        <!-- 处方类型标签 -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,4">
                            <TextBlock FontSize="10" FontWeight="Bold" Padding="4,1" Margin="0,0,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="普通处方"/>
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PrescriptionType}" Value="0">
                                                <Setter Property="Text" Value="普通处方"/>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding PrescriptionType}" Value="1">
                                                <Setter Property="Text" Value="急 诊"/>
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Setter Property="Foreground" Value="#F57F17"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding PrescriptionType}" Value="2">
                                                <Setter Property="Text" Value="儿 科"/>
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Setter Property="Foreground" Value="#558B2F"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>

                        <Line X1="0" Y1="0" X2="1" Y2="0" Stretch="Fill" Stroke="#9CA3AF" StrokeThickness="1" Margin="0,0,0,6"/>

                        <!-- 患者信息 -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="50"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="姓名：" FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding SelectedPatient.Name, FallbackValue='—'}" FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="性别：" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            <TextBlock Grid.Column="3" Text="{Binding SelectedPatient.Gender, FallbackValue='—'}" FontSize="11" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- 主诉 + 诊断 -->
                        <TextBlock FontSize="11" Margin="0,0,0,2" TextWrapping="Wrap">
                            <Run Text="主诉："/><Run Text="{Binding ChiefComplaint, FallbackValue='—'}"/>
                        </TextBlock>
                        <TextBlock FontSize="11" Margin="0,0,0,6" TextWrapping="Wrap">
                            <Run Text="临床诊断："/><Run Text="{Binding DiagnosisText, FallbackValue='—'}"/>
                        </TextBlock>

                        <!-- Rp 标示 -->
                        <TextBlock Text="Rp" FontSize="14" FontWeight="Bold" Margin="0,4,0,4"/>

                        <!-- 处方明细（内联编辑） -->
                        <DataGrid x:Name="ItemsDataGrid"
                                  ItemsSource="{Binding PrescriptionItems}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#E5E7EB"
                                  BorderThickness="0"
                                  CellEditEnding="ItemsDataGrid_CellEditEnding">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="FontSize" Value="10"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Padding" Value="4,2"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderBrush" Value="#D1D5DB"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="FontSize" Value="11"/>
                                    <Setter Property="Padding" Value="2"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                </Style>
                            </DataGrid.CellStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="药品名称" Binding="{Binding DrugName}" Width="*" IsReadOnly="True"/>
                                <DataGridTextColumn Header="规格" Binding="{Binding Spec}" Width="60" IsReadOnly="True"/>
                                <DataGridTextColumn Header="剂量" Width="40">
                                    <DataGridTextColumn.Binding>
                                        <Binding Path="Dose" UpdateSourceTrigger="PropertyChanged" Converter="{StaticResource DecimalInput}"/>
                                    </DataGridTextColumn.Binding>
                                </DataGridTextColumn>
                                <DataGridComboBoxColumn Header="单位" Width="40"
                                                         SelectedItemBinding="{Binding DoseUnit, UpdateSourceTrigger=PropertyChanged}"
                                                         ItemsSource="{StaticResource DoseUnits}"/>
                                <DataGridComboBoxColumn Header="频次" Width="65"
                                                         SelectedItemBinding="{Binding Frequency, UpdateSourceTrigger=PropertyChanged}"
                                                         ItemsSource="{StaticResource Frequencies}"/>
                                <DataGridComboBoxColumn Header="用法" Width="55"
                                                         SelectedItemBinding="{Binding Route, UpdateSourceTrigger=PropertyChanged}"
                                                         ItemsSource="{StaticResource Routes}"/>
                                <DataGridTextColumn Header="天" Binding="{Binding DurationDays, UpdateSourceTrigger=PropertyChanged}" Width="35"/>
                                <DataGridTextColumn Header="数量" Width="40">
                                    <DataGridTextColumn.Binding>
                                        <Binding Path="Qty" UpdateSourceTrigger="PropertyChanged" Converter="{StaticResource DecimalInput}"/>
                                    </DataGridTextColumn.Binding>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="金额" Binding="{Binding Subtotal, StringFormat=F2}" Width="50" IsReadOnly="True"/>
                                <DataGridTemplateColumn Header="" Width="40">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="✕"
                                                    FontSize="10" Padding="4,1" Margin="0"
                                                    Background="#FEF2F2" BorderBrush="#FCA5A5" Foreground="#DC2626"
                                                    Cursor="Hand"
                                                    Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding DataContext.IsDraft, RelativeSource={RelativeSource AncestorType=DataGrid}, Converter={StaticResource BoolToVisibility}}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- 处方完毕标记 -->
                        <TextBlock Text="/" FontSize="14" HorizontalAlignment="Right" Margin="0,2,0,4"/>

                        <!-- 合计金额 -->
                        <DockPanel Margin="0,4,0,8">
                            <TextBlock DockPanel.Dock="Right" FontSize="12" FontWeight="Bold">
                                <Run Text="合计：¥"/>
                                <Run Text="{Binding TotalAmount, StringFormat=F2, Mode=OneWay}"/>
                            </TextBlock>
                        </DockPanel>

                        <!-- 签名区 -->
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1" FontSize="11" VerticalAlignment="Center">
                                <Run Text="医师签名："/>
                                <Run Text="{Binding DoctorName, FallbackValue='_________', Mode=OneWay}" FontWeight="SemiBold"/>
                            </TextBlock>
                            <TextBlock Grid.Column="3" Text="审核/调配：_________" FontSize="11" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ── AI药师审核意见（分级分色，仅参考不阻断） ── -->
                <Border Margin="0,0,0,8" Padding="10,6" CornerRadius="4"
                        Visibility="{Binding HasAiAdvice, Converter={StaticResource BoolToVisibility}}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#F0FDF4"/>
                            <Setter Property="BorderBrush" Value="#A7F3D0"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding AiAdviceLevel}" Value="1">
                                    <Setter Property="Background" Value="#FFFBEB"/>
                                    <Setter Property="BorderBrush" Value="#FDE68A"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding AiAdviceLevel}" Value="2">
                                    <Setter Property="Background" Value="#FFF7ED"/>
                                    <Setter Property="BorderBrush" Value="#FDBA74"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding AiAdviceLevel}" Value="3">
                                    <Setter Property="Background" Value="#FEF2F2"/>
                                    <Setter Property="BorderBrush" Value="#FCA5A5"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock FontSize="11" FontWeight="SemiBold" Margin="0,0,0,2">
                            <Run Text="📋 AI药师审核（仅供参考，最终由执业医生决定）"/>
                        </TextBlock>
                        <TextBlock Text="{Binding AiPharmacistAdvice}" FontSize="11" TextWrapping="Wrap"
                                   Foreground="#374151"/>
                    </StackPanel>
                </Border>

                <!-- ── 状态消息 ── -->
                <StackPanel Margin="0,4,0,0">
                    <TextBlock Text="{Binding ErrorMessage}"
                               Style="{StaticResource TextError}"
                               Visibility="{Binding ErrorMessage, Converter={StaticResource NullToCollapsed}}"/>
                    <TextBlock Text="{Binding StatusMessage}"
                               Style="{StaticResource TextSuccess}"
                               Visibility="{Binding StatusMessage, Converter={StaticResource NullToCollapsed}}"/>
                </StackPanel>

                <!-- ── 操作按钮 ── -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                    <Button Style="{StaticResource BtnOutline}"
                            Command="{Binding NewPrescriptionCommand}"
                            Margin="0,0,8,0" Content="新建处方"/>
                    <Button Style="{StaticResource BtnOutline}"
                            Command="{Binding SavePrescriptionCommand}"
                            Margin="0,0,8,0" Content="仅保存"/>
                    <Button Style="{StaticResource BtnPrimaryLg}"
                            Command="{Binding SaveAndReviewCommand}"
                            Margin="0,0,8,0" Content="保存并打印"/>
                    <Button Style="{StaticResource BtnSuccess}"
                            Command="{Binding GoToBillingCommand}"
                            Visibility="{Binding CanGoToBilling, Converter={StaticResource BoolToVisibility}}"
                            Content="前往收费"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
